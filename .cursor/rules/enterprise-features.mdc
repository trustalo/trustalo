description: Rules for Trustalo Enterprise Edition modules and license-gated features
globs: "{**/*.ee.ts,**/*.ee.tsx,**/*.ee.test.ts,**/ee/**,**/*.ee/**,**/*.ee/**/*,packages/*.ee/**,packages/auth-provider-saml.ee/**,packages/license/src/**/*.ts,docs/enterprise.md,LICENSE_EE,README.md}"
alwaysApply: false
