# =========================================
# Trustalo - Environment Configuration
# =========================================
# Copy this file to .env and fill in the shared values.
# Each app also needs its own local env file copied from apps/<app>/.env.example.

# -----------------------------------------
# General
# -----------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# -----------------------------------------
# API Service (apps/api)
# -----------------------------------------
API_PORT=15002
API_URL=http://localhost:15002
CORS_ALLOWED_ORIGINS=http://localhost:15000

# API PostgreSQL (compliance domain)
API_DATABASE_URL=postgresql://trustalo:trustalo@localhost:5433/trustalo_api

# MongoDB (evidence & document store - owned by API)
MONGODB_URL=mongodb://trustalo:trustalo@localhost:27018/trustalo?authSource=admin

# -----------------------------------------
# Collector Service (apps/collector)
# -----------------------------------------
COLLECTOR_PORT=15003
COLLECTOR_URL=http://localhost:15003

# Collector PostgreSQL (integration domain)
COLLECTOR_DATABASE_URL=postgresql://trustalo:trustalo@localhost:5433/trustalo_collector

# Internal API client (collector -> API for evidence submission)
API_BASE_URL=http://localhost:15002
API_INTERNAL_KEY=trustalo-internal-dev-key

# Credential encryption (AES-256-GCM for integration credentials at rest).
# REQUIRED in production — must be exactly 64 hex characters (32 bytes).
# Generate one with:
#   openssl rand -hex 32
# (or `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
# Leave empty in dev to use the insecure deterministic fallback.
CREDENTIAL_ENCRYPTION_KEY=

# -----------------------------------------
# Web Frontend (apps/web)
# -----------------------------------------
WEB_PORT=15000
NEXT_PUBLIC_API_URL=http://localhost:15002
NEXT_PUBLIC_COLLECTOR_URL=http://localhost:15003

# -----------------------------------------
# JWT Authentication (shared by API + Collector)
# -----------------------------------------
JWT_SECRET=trustalo-jwt-dev-secret-change-in-production
JWT_EXPIRES_IN=24h
AUTH_OAUTH_STATE_SECRET=trustalo-oauth-state-dev-secret-change-in-production

# AI provider config envelope encryption (AES-256-GCM). REQUIRED in production —
# must be exactly 64 hex characters (32 bytes). Generate with:
#   openssl rand -hex 32
# Leave empty in dev to use the SHA-256-derived deterministic dev fallback
# (see apps/api/src/lib/crypto-envelope.ts).
AI_PROVIDER_CONFIG_ENCRYPTION_KEY=

# -----------------------------------------
# AWS S3 - File Storage
# -----------------------------------------
# Provider: s3 | gcs | azure (only s3 implemented)
STORAGE_PROVIDER=s3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET=trustalo-files
# LocalStack endpoint for local dev (remove for real AWS)
S3_ENDPOINT=http://localhost:4566

# -----------------------------------------
# AWS SQS - Event Queue
# -----------------------------------------
# Provider: sqs | pubsub | servicebus (only sqs implemented)
QUEUE_PROVIDER=sqs
SQS_ENDPOINT=http://localhost:4566
SQS_EVIDENCE_QUEUE_URL=http://localhost:4566/000000000000/trustalo-evidence
SQS_JOBS_QUEUE_URL=http://localhost:4566/000000000000/trustalo-jobs
SQS_VENDOR_RESEARCH_REQUESTS_URL=http://localhost:4566/000000000000/trustalo-vendor-research-requests
SQS_VENDOR_RESEARCH_RESULTS_URL=http://localhost:4566/000000000000/trustalo-vendor-research-results
SQS_QUESTIONNAIRE_IMPORT_JOBS_URL=http://localhost:4566/000000000000/trustalo-questionnaire-import-jobs

# -----------------------------------------
# AI Provider (operator default — used by all AI features)
# -----------------------------------------
# Resolution precedence: operator (env, this section) → per-org settings
# → per-feature override. See README "Self-hosting" for details.
#
# AI_PROVIDER: bedrock | openai | anthropic | openrouter | none
#   - "none" disables all AI features unless an org configures their own
#     provider in Settings → AI.
#   - "bedrock" works with the AWS default credential chain (env, profile,
#     IMDS, IAM role) — no static keys needed when running on EC2/ECS/EKS.
AI_PROVIDER=none
AI_DEFAULT_MODEL=

# OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=

# AWS Bedrock (omit access keys to use the AWS default credential chain)
# AI_BEDROCK_REGION=us-east-1
# AI_BEDROCK_ACCESS_KEY_ID=
# AI_BEDROCK_SECRET_ACCESS_KEY=

# OpenRouter
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=

# -----------------------------------------
# AI / Research (Collector — vendor research only)
# -----------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Search Engine: tavily | serper | google | brave
# Only the API key for the selected engine is required.
SEARCH_ENGINE=tavily
TAVILY_API_KEY=tvly-...
SERPER_API_KEY=
GOOGLE_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
BRAVE_API_KEY=
