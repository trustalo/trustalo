# API Service (apps/api)
# Copy to .env for local development

NODE_ENV=development
LOG_LEVEL=debug
API_PORT=4000
API_URL=http://localhost:4000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Deployment posture. Controls how errors are surfaced to end users:
#   saas        — Trustalo-hosted multi-tenant. All upstream/internal
#                 errors (OpenAI 401s, S3 failures, stack traces, etc.)
#                 are replaced with friendly generic copy in API
#                 responses. Full detail still lands in server logs.
#                 This is the safe default.
#   self_hosted — Customer-deployed. The end user IS the operator/admin
#                 and benefits from seeing the (still-secret-scrubbed)
#                 upstream error to fix their own configuration.
DEPLOYMENT_MODE=saas

# PostgreSQL (compliance domain)
API_DATABASE_URL=postgresql://trustalo:trustalo@localhost:5433/trustalo_api

# ─────────────────────────────────────────────────────────────────────────
# Evidence Collector (service-to-service)
# ─────────────────────────────────────────────────────────────────────────
# The API proxies a small number of operations to the Collector service:
#   - listing connected integrations for the agent tool picker
#   - dispatching and inspecting evidence-agent runs
# Cross-service traffic is authenticated with HMAC-signed requests
# (X-Service-Signature header) using the secret below. Both services
# must share the same value. SERVICE_AUTH_SECRET overrides API_INTERNAL_KEY
# for HMAC signing if set; API_INTERNAL_KEY is still accepted as a legacy
# X-Internal-Key fallback during rollout.
COLLECTOR_BASE_URL=http://localhost:4001
API_INTERNAL_KEY=change-me-in-production
# SERVICE_AUTH_SECRET=optional-dedicated-hmac-secret-for-service-to-service

# MongoDB (evidence & document store)
MONGODB_URL=mongodb://trustalo:trustalo@localhost:27018/trustalo?authSource=admin

# JWT Authentication
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=24h
AUTH_OAUTH_STATE_SECRET=change-me-in-production-oauth-state-secret-32chars
# AI provider config envelope encryption (AES-256-GCM). REQUIRED in production —
# must be exactly 64 hex characters (32 bytes). Generate with:
#   openssl rand -hex 32
# Leave empty in dev to use the SHA-256-derived deterministic dev fallback
# (see apps/api/src/lib/crypto-envelope.ts).
AI_PROVIDER_CONFIG_ENCRYPTION_KEY=
# Parent domain shared by web + API so the httpOnly session cookie can
# travel between them. Leave unset in single-host or dev setups where
# the cookie's default same-origin scope is sufficient.
# SESSION_COOKIE_DOMAIN=.example.com

# ─────────────────────────────────────────────────────────────────────────
# Pluggable authentication
# ─────────────────────────────────────────────────────────────────────────
# Selects the active auth provider. Exactly one provider is active per
# deployment. Supported values:
#   local      Email + password verified against User.passwordHash (default)
#   cognito    AWS Cognito Hosted UI (OAuth2 + PKCE; supports MFA, social, SAML)
#   keycloak   Self-hosted Keycloak realm (OIDC + PKCE; supports MFA, social, SAML)
#   external   Dynamic-import a third-party plugin from an npm package
# See docs/auth-providers.md for the full list of plugins and how to write one.
AUTH_PROVIDER=local

# Used to sign the short-lived OAuth state JWT roundtripped through the IdP.
# Must be at least 32 chars.

# ── local provider ──
# Set to "false" to disable the public /auth/register endpoint in production.
# AUTH_LOCAL_ALLOW_REGISTRATION=true

# ── cognito provider (required when AUTH_PROVIDER=cognito) ──
# COGNITO_REGION=us-east-1
# COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
# COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# COGNITO_CLIENT_SECRET=                       # only if pool client has a secret
# COGNITO_DOMAIN=mycompany.auth.us-east-1.amazoncognito.com
# COGNITO_SCOPES=openid email profile          # default
# COGNITO_DISPLAY_NAME=AWS Cognito             # shown on the login button
# COGNITO_MFA_ENABLED=true                     # informational only — Cognito enforces MFA
# COGNITO_SOCIAL_LOGIN_ENABLED=true            # informational only

# ── keycloak provider (required when AUTH_PROVIDER=keycloak) ──
# KEYCLOAK_BASE_URL=https://kc.example.com           # no trailing slash
# KEYCLOAK_REALM=trustalo
# KEYCLOAK_CLIENT_ID=trustalo-web
# KEYCLOAK_CLIENT_SECRET=                            # only for confidential clients
# KEYCLOAK_SCOPES=openid email profile               # default
# KEYCLOAK_DISPLAY_NAME=Keycloak                     # shown on login button
# KEYCLOAK_MFA_ENABLED=true                          # informational only — Keycloak enforces MFA
# KEYCLOAK_SOCIAL_LOGIN_ENABLED=true                 # informational only
# Admin REST credentials for invitation flow (optional but required to invite users):
#   - dedicated confidential client with `Service Accounts Enabled`
#   - service account granted realm-management role `manage-users`
# KEYCLOAK_ADMIN_CLIENT_ID=trustalo-admin
# KEYCLOAK_ADMIN_CLIENT_SECRET=

# ── external provider (required when AUTH_PROVIDER=external) ──
# AUTH_EXTERNAL_PROVIDER=@your-org/trustalo-auth-provider-okta
# Plus whatever env vars your chosen plugin documents.

# AWS S3
STORAGE_PROVIDER=s3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=trustalo-files
S3_ENDPOINT=http://localhost:4566

# AWS SQS
QUEUE_PROVIDER=sqs
SQS_ENDPOINT=http://localhost:4566
SQS_EVIDENCE_QUEUE_URL=http://localhost:4566/000000000000/trustalo-evidence
SQS_JOBS_QUEUE_URL=http://localhost:4566/000000000000/trustalo-jobs

AI_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
