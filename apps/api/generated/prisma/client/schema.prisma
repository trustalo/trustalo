  options QuizOption[]
  answers QuizAnswer[]

  @@index([quizId])
}

model QuizOption {
  id         String  @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean @default(false)
  sortOrder  Int     @default(0)

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  QuizAnswer[]

  @@index([questionId])
}

model QuizAttempt {
  id          String    @id @default(cuid())
  quizId      String
  userId      String
  tenantId    String
  score       Int?
  totalPoints Int?
  percentage  Int?
  passed      Boolean?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  quiz    TrainingQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id])
  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]

  @@index([tenantId])
  @@index([quizId])
  @@index([userId])
}

model QuizAnswer {
  id         String  @id @default(cuid())
  attemptId  String
  questionId String
  optionId   String?
  isCorrect  Boolean @default(false)

  attempt  QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  option   QuizOption?  @relation(fields: [optionId], references: [id])

  @@index([attemptId])
}

// --- trust-center.prisma ---
enum TrustResourceType {
  certificate
  report
  policy
  attestation
}

enum TrustResourceGating {
  public
  contact_required
  nda_required
}

enum AccessRequestStatus {
  pending
  approved
  rejected
}

// Phase 2 (AI accelerators): controls how the public payload is built.
// - `live`  — query the latest data on every (cached) request.
// - `snapshot` — serve the most recent admin-published TrustCenterSnapshot.
//   Useful for orgs that want a stable view between formal updates.
enum TrustCenterPublicMode {
  live
  snapshot
}

model TrustCenterConfig {
  id           String                @id @default(cuid())
  tenantId     String                @unique
  isEnabled    Boolean               @default(false)
  customDomain String?
  brandColor   String?
  logoUrl      String?
  description  String?
  faqs         Json?
  publicMode   TrustCenterPublicMode @default(live)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  resources TrustResource[]
  snapshots TrustCenterSnapshot[]
  events    TrustCenterEvent[]

  @@index([tenantId])
}

// A frozen copy of the public payload, captured by an admin via
// "Publish snapshot". Only the most recent row per org is read by the
// public surface when publicMode = 'snapshot'.
model TrustCenterSnapshot {
  id                  String   @id @default(cuid())
  tenantId            String
  trustCenterConfigId String
  payload             Json
  publishedById       String
  createdAt           DateTime @default(now())

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trustCenterConfig TrustCenterConfig @relation(fields: [trustCenterConfigId], references: [id], onDelete: Cascade)
  publishedBy       User              @relation("TrustCenterSnapshotPublisher", fields: [publishedById], references: [id])

  @@index([tenantId, createdAt])
  @@index([trustCenterConfigId])
}

// Lightweight visitor audit so admins can see what each prospect viewed.
// Recorded by the public router on view + on resource interaction;
// retained 90 days by a future cleanup job.
enum TrustCenterEventType {
  view
  resource_view
  resource_download
  access_request
}

model TrustCenterEvent {
  id                  String               @id @default(cuid())
  tenantId            String
  trustCenterConfigId String
  type                TrustCenterEventType
  resourceId          String?
  visitorIp           String?
  visitorUa           String?
  visitorEmail        String?
  metadata            Json?
  createdAt           DateTime             @default(now())

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trustCenterConfig TrustCenterConfig @relation(fields: [trustCenterConfigId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([trustCenterConfigId, createdAt])
  @@index([type, createdAt])
}

model TrustResource {
  id                  String              @id @default(cuid())
  tenantId            String
  trustCenterConfigId String
  title               String
  description         String?
  frameworkType       String?
  resourceType        TrustResourceType
  fileUrl             String
  isPublic            Boolean             @default(false)
  accessGating        TrustResourceGating @default(public)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  tenant            Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trustCenterConfig TrustCenterConfig          @relation(fields: [trustCenterConfigId], references: [id], onDelete: Cascade)
  accessRequests    TrustCenterAccessRequest[]

  @@index([tenantId])
  @@index([trustCenterConfigId])
}

model TrustCenterAccessRequest {
  id               String              @id @default(cuid())
  tenantId         String
  resourceId       String
  requesterName    String
  requesterEmail   String
  requesterCompany String
  requesterTitle   String?
  reason           String?
  status           AccessRequestStatus @default(pending)
  ndaAccepted      Boolean             @default(false)
  approvedById     String?
  approvedAt       DateTime?
  rejectedReason   String?
  accessToken      String              @unique @default(cuid())
  expiresAt        DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  resource   TrustResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  approvedBy User?         @relation("AccessRequestApprover", fields: [approvedById], references: [id])

  @@index([tenantId])
  @@index([accessToken])
  @@index([requesterEmail, tenantId])
  @@index([resourceId])
}

// --- user.prisma ---
enum MembershipRole {
  owner
  admin
  compliance_manager
  auditor
  viewer
  integration_admin
  // Data Protection Officer (GDPR Art. 37). Privacy-program-scoped role with
  // read access across the platform and write access to privacy resources
  // (RoPA, DPIAs, data-breach register, DSARs).
  dpo
}

enum MembershipStatus {
  active
  invited
  suspended
}

enum DirectorySyncProvider {
  entra
  google_workspace
}

enum DirectorySyncDefaultStatus {
  active
  invited
}

enum DirectorySyncRunStatus {
  pending
  running
  succeeded
  failed
  cancelled
}

enum DirectorySyncRunTrigger {
  schedule
  manual
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  // Password hash is only populated when the active auth provider is a
  // credential provider (e.g. local). It is null for users that authenticate
  // via redirect providers (Cognito, OIDC, SAML, ...).
  passwordHash  String?
  // Identifier of the auth provider that owns this account. Must match the
  // `id` returned by the provider plugin (e.g. "local", "cognito", or any
  // third-party plugin id). Null only for users that have not yet completed
  // first login (e.g. invited users on a redirect provider).
  authProvider  String?
  // Stable, opaque user identifier returned by the auth provider:
  //   - local    : the user's email address
  //   - cognito  : the user pool's `sub` claim
  //   - <plugin> : provider-specific stable id
  // Together with `authProvider`, this uniquely identifies the account.
  externalId    String?
  avatarUrl     String?
  emailVerified Boolean   @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships               Membership[]
  people                    Person[]
  ownedControls             Control[]                  @relation("ControlOwner")
  ownedPolicies             Policy[]                   @relation("PolicyOwner")
  createdPolicyVersions     PolicyVersion[]            @relation("PolicyVersionCreator")
  approvedPolicyVersions    PolicyVersion[]            @relation("PolicyVersionApprover")
  policyAcknowledgments     PolicyAcknowledgment[]
  ownedRisks                Risk[]                     @relation("RiskOwner")
  actionOwnedRisks          Risk[]                     @relation("RiskActionOwner")
  riskAssessments           RiskAssessment[]           @relation("RiskAssessor")
  riskTreatments            RiskTreatment[]            @relation("RiskTreatmentResponsible")
  riskMatrixChanges         RiskMatrixChange[]         @relation("RiskMatrixChangeAuthor")
  vendorAssessments         VendorAssessment[]         @relation("VendorAssessor")
  vendorDocuments           VendorDocument[]           @relation("VendorDocUploader")
  ownedAssets               Asset[]                    @relation("AssetOwner")
  deletedAssets             Asset[]                    @relation("AssetDeletedBy")
  reportedIncidents         Incident[]                 @relation("IncidentReporter")
  assignedIncidents         Incident[]                 @relation("IncidentAssignee")
  incidentTimelineActions   IncidentTimeline[]
  assignedAuditFindings     AuditFinding[]             @relation("AuditFindingAssignee")
  uploadedAuditDocuments    AuditDocument[]            @relation("AuditDocumentUploader")
  ownedBcps                 BusinessContinuityPlan[]   @relation("BCPOwner")
  ownedBias                 BusinessImpactAnalysis[]   @relation("BIAOwner")
  facilitatedBcpExercises   BCPExercise[]              @relation("BCPExerciseFacilitator")
  ownedAiSystems            AISystem[]                 @relation("AISystemOwner")
  aiRiskAssessments         AIRiskAssessment[]         @relation("AIRiskAssessor")
  aiRiskApprovals           AIRiskAssessment[]         @relation("AIRiskApprover")
  aiImpactAssessments       AIImpactAssessment[]       @relation("AIImpactAssessor")
  aiImpactApprovals         AIImpactAssessment[]       @relation("AIImpactApprover")
  reportedAiIncidents       AIIncident[]               @relation("AIIncidentReporter")
  assignedAiIncidents       AIIncident[]               @relation("AIIncidentAssignee")
  assignedTasks             Task[]                     @relation("TaskAssignee")
  submittedEvidence         TaskEvidence[]             @relation("EvidenceSubmitter")
  approvedEvidence          TaskEvidence[]             @relation("EvidenceApprover")
  submittedControlEvidence  Evidence[]                 @relation("EvidenceSubmittedBy")
  reviewedControlEvidence   Evidence[]                 @relation("EvidenceReviewedBy")
  trainingCompletions       TrainingCompletion[]
  quizAttempts              QuizAttempt[]
  policyComments            PolicyComment[]            @relation("PolicyCommentAuthor")
  resolvedComments          PolicyComment[]            @relation("PolicyCommentResolver")
  approvedAccessRequests    TrustCenterAccessRequest[] @relation("AccessRequestApprover")
  publishedTrustSnapshots   TrustCenterSnapshot[]      @relation("TrustCenterSnapshotPublisher")
  reportedVulnerabilities   Vulnerability[]            @relation("VulnReporter")
  assignedVulnerabilities   Vulnerability[]            @relation("VulnAssignee")
  ownedProcessingActivities ProcessingActivity[]       @relation("ProcessingActivityOwner")
  dpiaAssessments           DPIA[]                     @relation("DPIAAssessor")
  dpiaApprovals             DPIA[]                     @relation("DPIAApprover")
  reportedDataBreaches      DataBreach[]               @relation("DataBreachReporter")
  assignedDataBreaches      DataBreach[]               @relation("DataBreachAssignee")
  reportedControlWeaknesses ControlWeakness[]          @relation("ControlWeaknessReporter")
  assignedControlWeaknesses ControlWeakness[]          @relation("ControlWeaknessAssignee")
  assignedDsarRequests      DSARRequest[]              @relation("DSARAssignee")
  importedQuestionnaires    Questionnaire[]            @relation("QuestionnaireImporter")
  reviewedAnswers           Answer[]                   @relation("AnswerReviewer")
  questionnaireImportJobs   QuestionnaireImportJob[]   @relation("QuestionnaireImportJobCreator")
  externalIdentityMappings  ExternalIdentityMapping[]
  deviceTokensCreated       DeviceEnrollmentToken[]    @relation("DeviceTokenCreatedBy")
  devicesEnrolled           Device[]                   @relation("DeviceEnrolledBy")
  deviceAuthCodes           DeviceAuthCode[]

  @@unique([authProvider, externalId])
  @@index([authProvider])
}

model Membership {
  id          String           @id @default(cuid())
  userId      String
  tenantId    String
  role        MembershipRole   @default(viewer)
  permissions String[]
  status      MembershipStatus @default(invited)
  invitedAt   DateTime?
  joinedAt    DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([userId])
}

model DirectorySyncConfig {
  id                   String                     @id @default(cuid())
  tenantId             String
  provider             DirectorySyncProvider
  isEnabled            Boolean                    @default(true)
  syncFrequencyMinutes Int                        @default(1440)
  defaultRole          MembershipRole             @default(viewer)
  defaultStatus        DirectorySyncDefaultStatus @default(invited)
  groupRoleMappings    Json?
  encryptedCredentials String                     @db.Text
  lastSyncAt           DateTime?
  lastSyncStatus       DirectorySyncRunStatus?
  lastSyncError        String?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  tenant   Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runs     DirectorySyncRun[]
  mappings ExternalIdentityMapping[]

  @@unique([tenantId, provider])
  @@index([tenantId])
  @@index([tenantId, isEnabled])
}

model DirectorySyncRun {
  id              String                  @id @default(cuid())
  tenantId        String
  configId        String
  provider        DirectorySyncProvider
  status          DirectorySyncRunStatus  @default(pending)
  triggeredBy     DirectorySyncRunTrigger @default(schedule)
  startedAt       DateTime?
  finishedAt      DateTime?
  usersDiscovered Int                     @default(0)
  usersCreated    Int                     @default(0)
  usersUpdated    Int                     @default(0)
  usersSuspended  Int                     @default(0)
  errorMessage    String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  tenant Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  config DirectorySyncConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([configId, status])
}

model ExternalIdentityMapping {
  id                  String                @id @default(cuid())
  tenantId            String
  configId            String
  provider            DirectorySyncProvider
  externalId          String
  userId              String
  externalEmail       String
  externalDisplayName String?
  externalGroupIds    String[]
  lastSeenAt          DateTime
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  tenant Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  config DirectorySyncConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  user   User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider, externalId])
  @@index([tenantId, provider, lastSeenAt])
  @@index([userId, tenantId])
}

// --- vendor.prisma ---
enum VendorRiskTier {
  critical
  high
  medium
  low
}

enum VendorStatus {
  active
  under_review
  approved
  rejected
  offboarded
}

enum ResearchFrequency {
  weekly
  biweekly
  monthly
  yearly
  none
}

enum ResearchStatus {
  pending
  in_progress
  completed
  failed
}

enum DpaStatus {
  not_required
  not_started
  requested
  received
  approved
  expired
}

// Global vendor catalog shared across all tenancies to avoid duplicate research
model KnownVendor {
  id               String    @id @default(cuid())
  name             String
  normalizedName   String    @unique
  website          String?
  description      String?
  category         String?
  logoUrl          String?
  headquarters     String?
  employeeRange    String?
  foundedYear      Int?
  industries       String[]
  certifications   String[]
  lastResearchedAt DateTime?
  researchData     Json?
  riskSummary      String?   @db.Text
  overallScore     Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  vendors    Vendor[]
  researches VendorResearch[]

  @@index([normalizedName])
}

model Vendor {
  id                  String            @id @default(cuid())
  tenantId            String
  name                String
  description         String?
  website             String?
  category            String?
  riskTier            VendorRiskTier    @default(medium)
  status              VendorStatus      @default(active)
  dataProcessing      Boolean           @default(false)
  isSubprocessor      Boolean           @default(false)
  subprocessorPurpose String?
  dataTypesShared     String[]
  dataLocations       String[]
  dpaStatus           DpaStatus         @default(not_required)
  dpaExpiresAt        DateTime?
  contractStartDate   DateTime?
  contractEndDate     DateTime?
  knownVendorId       String?
  researchFrequency   ResearchFrequency @default(none)
  lastResearchedAt    DateTime?
  nextResearchAt      DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  knownVendor          KnownVendor?         @relation(fields: [knownVendorId], references: [id])
  assessments          VendorAssessment[]
  contacts             VendorContact[]
  researches           VendorResearch[]
  documents            VendorDocument[]
  // Vendor contacts promoted to People (Phase D) so they can be vetted /
  // acknowledge policies / take training like staff.
  people               Person[]
  // M:M link to GDPR Processing Activities for which this vendor processes
  // personal data on the controller's behalf (Art. 28 sub-processor view).
  processingActivities ProcessingActivity[] @relation("VendorProcessingActivities")
  questionnaires       Questionnaire[]

  @@index([tenantId])
  @@index([knownVendorId])
  @@index([nextResearchAt])
}

model VendorAssessment {
  id             String    @id @default(cuid())
  vendorId       String
  tenantId       String
  assessedById   String
  score          Int?
  findings       String?
  nextReviewDate DateTime?
  researchId     String?
  createdAt      DateTime  @default(now())

  vendor     Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assessedBy User            @relation("VendorAssessor", fields: [assessedById], references: [id])
  research   VendorResearch? @relation(fields: [researchId], references: [id])

  @@index([tenantId])
  @@index([vendorId])
  @@index([researchId])
}

model VendorResearch {
  id            String         @id @default(cuid())
  vendorId      String?
  knownVendorId String?
  tenantId      String?
  status        ResearchStatus @default(pending)
  researchType  String         @default("deep_research")

  overallScore    Int?
  securityScore   Int?
  complianceScore Int?
  reputationScore Int?
  financialScore  Int?

  findings        Json?
  summary         String? @db.Text
  recommendations String? @db.Text
  dataBreaches    Json?
  certifications  Json?
  rawData         Json?

  startedAt    DateTime?
  completedAt  DateTime?
  errorMessage String?

  createdAt DateTime @default(now())

  vendor      Vendor?            @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  knownVendor KnownVendor?       @relation(fields: [knownVendorId], references: [id])
  tenant      Tenant?            @relation(fields: [tenantId], references: [id])
  assessments VendorAssessment[]

  @@index([vendorId])
  @@index([knownVendorId])
  @@index([tenantId])
  @@index([status])
}

model VendorContact {
  id        String  @id @default(cuid())
  vendorId  String
  name      String
  email     String?
  role      String?
  phone     String?
  isPrimary Boolean @default(false)

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
}

enum VendorDocumentType {
  agreement
  nda
  sla
  dpa
  sow
  msa
  insurance_certificate
  security_assessment
  compliance_report
  other
}

model VendorDocument {
  id           String             @id @default(cuid())
  vendorId     String
  tenantId     String
  documentType VendorDocumentType @default(other)
  title        String
  description  String?
  fileKey      String
  fileName     String
  fileSize     Int
  mimeType     String
  expiresAt    DateTime?
  uploadedById String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  vendor     Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploadedBy User   @relation("VendorDocUploader", fields: [uploadedById], references: [id])

  @@index([vendorId])
  @@index([tenantId])
}

// --- vulnerability.prisma ---
enum VulnerabilitySeverity {
  critical
  high
  medium
  low
  informational
}

enum VulnerabilityStatus {
  open
  confirmed
  in_progress
  remediated
  accepted
  false_positive
}

enum VulnerabilitySource {
  scan
  pentest
  bug_bounty
  manual
  vendor_advisory
}

model Vulnerability {
  id                String                @id @default(cuid())
  tenantId          String
  title             String
  description       String?
  severity          VulnerabilitySeverity
  status            VulnerabilityStatus   @default(open)
  source            VulnerabilitySource   @default(manual)
  cvssScore         Float?
  cveId             String?
  cweId             String?
  affectedComponent String?
  productionImpact  Boolean               @default(false)
  reportedById      String
  assignedToId      String?
  detectedAt        DateTime?
  remediatedAt      DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reportedBy User   @relation("VulnReporter", fields: [reportedById], references: [id])
  assignedTo User?  @relation("VulnAssignee", fields: [assignedToId], references: [id])

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, severity])
}
