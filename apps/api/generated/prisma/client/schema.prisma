// --- billing.ee.prisma ---
// EE: Trustalo-managed LiteLLM routing + metered billing.
//
// This schema is loaded when running prisma:combine. It models the
// minimum state needed to:
//   - provision and refresh per-tenant LiteLLM virtual keys
//   - track prepaid credit balance (1 credit == 1 USD; markup is
//     baked into the purchase price)
//   - record per-call spend events for audit + reconciliation
//   - roll those events up monthly for fast dashboard reads
//
// All tables are gated at the application layer behind the `ai-metered`
// feature id (see packages/license/src/types.ts). Self-hosted
// deployments without an EE license will simply never write to them.

enum TenantBillingMode {
  // Trustalo pays the upstream provider via its master account on
  // LiteLLM. Tenant pays Trustalo at the markup-inclusive credit price.
  managed
  // Tenant brings their own provider keys. LiteLLM proxies their
  // traffic for logging/governance only; Trustalo applies 0% markup
  // on inference and bills only the platform fee.
  byok_passthrough
  // Operator has explicitly disabled metering for this tenant
  // (e.g. internal accounts, partner accounts). Skips wallet checks
  // and never debits. Should be used sparingly.
  disabled
}

enum TenantLiteLLMKeyStatus {
  active
  suspended
  expired
  rotating
}

model TenantBillingConfig {
  id                        String            @id @default(cuid())
  tenantId                  String            @unique
  mode                      TenantBillingMode @default(managed)
  // Hard ceiling (in microcents) the tenant can ever spend per month
  // regardless of wallet balance. Defence-in-depth against runaway
  // costs from a compromised account. `null` means unlimited.
  monthlySpendCapMicrocents BigInt?
  // Operator overrides for tier mapping. When set, takes precedence
  // over the per-feature `AIFeatureConfig.model`. Used for partner /
  // dev accounts that need a non-default routing.
  modelTierOverride         String?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model TenantLiteLLMKey {
  id                      String                 @id @default(cuid())
  tenantId                String                 @unique
  // LiteLLM's identifier for the key (its `/key/info` "token" hash).
  // Stable across rotations — only `virtualKeyCipher` changes.
  litellmKeyId            String                 @unique
  // AES-256-GCM ciphertext of the actual virtual key. NEVER logged
  // and decrypted lazily inside the resolver hot path.
  virtualKeyCipher        String
  // Comma-separated model aliases this key may use. Enforced
  // server-side by LiteLLM; mirrored here for fast pre-flight checks.
  modelAllowlist          String[]
  status                  TenantLiteLLMKeyStatus @default(active)
  // Max budget configured on LiteLLM for this key, in microcents.
  // `null` means no cap (managed-mode wallets enforce the cap via
  // top-up balance; pass-through mode usually leaves this null).
  budgetMaxMicrocents     BigInt?
  // Last-known LiteLLM-reported spend for reconciliation. Source of
  // truth lives on LiteLLM; this is a cache to detect drift.
  observedSpendMicrocents BigInt                 @default(0)
  lastSyncedAt            DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model CreditWallet {
  id                            String   @id @default(cuid())
  tenantId                      String   @unique
  // Available credits in microcents (USD). 1 credit == 1 USD ==
  // 1_000_000 microcents. Cannot go negative — the LLM path checks
  // this before resolving and 402s when zero.
  balanceMicrocents             BigInt   @default(0)
  // Lifetime stats for the dashboard.
  lifetimeCreditedMicrocents    BigInt   @default(0)
  lifetimeDebitedMicrocents     BigInt   @default(0)
  // Low-balance warning threshold (in microcents). When the balance
  // crosses this downward, a TaskService notification fires. `null`
  // means use the operator-level default.
  lowBalanceThresholdMicrocents BigInt?
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions CreditTransaction[]

  @@index([tenantId])
}

enum CreditTransactionKind {
  // Tenant purchased credits via Stripe.
  purchase
  // Operator gifted credits (trial, support credit, etc.).
  grant
  // Refund of a prior purchase (Stripe webhook).
  refund
  // LLM call debited the wallet (signed negative).
  debit
  // Reconciliation correction after spend-sync detected drift.
  adjustment
  // Promotional credit that expires.
  promotion_expiry
}

model CreditTransaction {
  id                     String                @id @default(cuid())
  walletId               String
  tenantId               String
  // Signed amount. Positive for credits added, negative for debits.
  amountMicrocents       BigInt
  kind                   CreditTransactionKind
  // Free-form human-readable reason. Surfaced in the billing UI.
  reason                 String?
  // For purchase/refund: the Stripe checkout session / payment intent.
  // For debit: the LiteLLMSpendEvent.id that triggered the debit.
  // For adjustment: the reconciliation run id.
  externalRef            String?
  // Snapshot of wallet balance AFTER applying this transaction. Lets
  // the UI render a running balance without re-summing the entire log.
  balanceAfterMicrocents BigInt
  createdAt              DateTime              @default(now())

  wallet CreditWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([walletId, createdAt])
}

model LiteLLMSpendEvent {
  id                 String    @id @default(cuid())
  tenantId           String
  feature            AIFeature
  model              String
  promptTokens       Int
  completionTokens   Int
  // Raw upstream cost reported by LiteLLM, in microcents (×1_000_000).
  // Stored at microcent precision because individual completions can
  // cost less than a full cent.
  rawCostMicrocents  BigInt
  // After Trustalo's markup. For BYOK pass-through this equals raw.
  markedUpMicrocents BigInt
  // LiteLLM's request id. Indexed unique so the spend sync is
  // idempotent and a webhook retry never double-debits.
  litellmRequestId   String    @unique
  occurredAt         DateTime
  createdAt          DateTime  @default(now())

  @@index([tenantId, occurredAt])
  @@index([tenantId, feature, occurredAt])
}

model TenantAIUsageMonth {
  tenantId               String
  // ISO month, e.g. "2026-05". Cheaper than a DateTime when the only
  // operation is monthly grouping.
  yearMonth              String
  totalPromptTokens      Int      @default(0)
  totalCompletionTokens  Int      @default(0)
  // Aggregate raw cost (microcents) — useful for cost-of-goods reports.
  totalRawCostMicrocents BigInt   @default(0)
  // Aggregate billed cost (microcents) — what hit the wallet.
  totalBilledMicrocents  BigInt   @default(0)
  // JSON breakdown by feature/model: { "chat_assistant": { tokens, billed }, ... }
  byFeature              Json     @default("{}")
  updatedAt              DateTime @updatedAt

  @@id([tenantId, yearMonth])
}

// --- chat.prisma ---
// ============================================================
// Chat — general compliance assistant.
//
// Phase 2 of the "ongoing AI context" plan. A `Conversation` is a
// chat thread between a user and the assistant. Each `Message` is
// one turn (user prompt or assistant reply).
//
// Design notes
// ────────────
// • The assistant is grounded against TenantContext + the
//   tenant's policies/risks/vendors/controls/frameworks. Each reply
//   stores `groundingHash` so audit reviewers can prove the assistant
//   was given exactly the same evidence on a re-run.
// • In parallel with the reply, an extraction worker scans the user's
//   turn for new facts and writes TenantContextProposal rows.
//   The ids of any proposals tied to a given assistant turn live in
//   `Message.proposalIds` so the UI can deep-link.
// • No tool-calling — the assistant cannot mutate tenant data. All
//   "context updates" go through the proposal review surface.
// • Conversations are tenant-scoped; the prismaWithTenant extension
//   injects `tenantId` automatically.
// ============================================================

enum MessageRole {
  user
  assistant
  system
}

model Conversation {
  id         String    @id @default(cuid())
  tenantId   String
  /// Auto-derived from the first user turn when null. Editable by the
  /// user from the conversation list.
  title      String?
  createdBy  String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  /// Soft-archive — hides from the list without deleting transcript.
  archivedAt DateTime?

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([tenantId])
  @@index([tenantId, archivedAt, updatedAt])
  @@index([createdBy])
}

model Message {
  id             String      @id @default(cuid())
  tenantId       String
  conversationId String
  role           MessageRole
  content        String      @db.Text
  /// Provider/model used to produce this assistant message — null for
  /// user/system messages. Surfaced in the UI footer for transparency.
  modelUsed      String?
  /// Source of the resolved provider (operator default / org provider /
  /// per-feature override). Mirrors the AdvisoryBanner pattern.
  providerSource String?
  /// Deterministic hash of the grounding bundle (context ids + policy
  /// ids + risk ids + vendor ids + recent message ids + truncation
  /// caps). Same hash means same evidence → reproducible answers in
  /// audits.
  groundingHash  String?
  /// Structured citations: array of { kind, id, label } objects the
  /// model emitted to back claims in `content`. Validated against the
  /// grounding bundle before persistence — citations to ids that
  /// weren't in the bundle are dropped to prevent hallucinated
  /// references.
  citations      Json        @default("[]")
  /// TenantContextProposal ids that the parallel extractor
  /// produced from the *user* turn paired with this assistant turn.
  /// Used by the right-side proposal panel to highlight which turn a
  /// given proposal came from.
  proposalIds    String[]    @default([])
  createdAt      DateTime    @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([conversationId, createdAt])
}

// --- control.prisma ---
enum ControlStatus {
  not_implemented
  partially_implemented
  implemented
  not_applicable
}

model Control {
  id                    String        @id @default(cuid())
  tenantId              String
  title                 String
  description           String?
  implementationDetails String?       @db.Text
  status                ControlStatus @default(not_implemented)
  category              String?
  ownerId               String?
  reviewDate            DateTime?
  lastReviewedAt        DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  tenant                        Tenant                           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner                         User?                            @relation("ControlOwner", fields: [ownerId], references: [id])
  controlRequirementAssignments ControlRequirementAssignment[]
  auditFindings                 AuditFinding[]
  tasks                         Task[]
  evidence                      Evidence[]
  policyControls                PolicyControl[]
  evidenceCollectionConfig      ControlEvidenceCollectionConfig?
  weaknesses                    ControlWeakness[]

  @@index([tenantId])
}

// ── Evidence collection mode (per-control, per-tenant) ────────
//
// Lets a user choose whether evidence for a control is gathered
// manually (existing behaviour) or by the Evidence Agent. In agent
// mode, `agentInstructions` is the natural-language directive the
// LLM receives, and `agentToolConnectionIds` are the collector
// IntegrationConnection IDs the agent is allowed to call as tools.
enum EvidenceCollectionMode {
  manual
  agent
}

enum EvidenceAgentLastStatus {
  idle
  queued
  running
  succeeded
  failed
}

model ControlEvidenceCollectionConfig {
  id                     String                  @id @default(cuid())
  tenantId               String
  controlId              String                  @unique
  mode                   EvidenceCollectionMode  @default(manual)
  agentInstructions      String?                 @db.Text
  agentToolConnectionIds String[]                @default([])
  agentScheduleMinutes   Int?
  agentLastRunAt         DateTime?
  agentLastStatus        EvidenceAgentLastStatus @default(idle)
  agentLastRunId         String?
  agentLastSummary       String?                 @db.Text
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  control Control @relation(fields: [controlId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, mode])
}

// ── ControlWeakness ─────────────────────────────────────────────────
//
// Tracks information-security control weaknesses for the APRA CPS 234
// Para 35 10-business-day notification clock. The model is generic
// enough to also support other regulator weakness-notification clocks
// later (e.g. CPS 230 operational risk) — the CPS 234 specifics live
// in the helper `computeCps234ControlWeaknessDeadline` and the router.
//
// Lifecycle (mirrors `DataBreachStatus`):
//   open       — discovered, not yet triaged
//   triaging   — materiality + remediability under assessment
//   notified   — APRA has been notified (or a nil-return recorded)
//   remediating — material; remediation in flight
//   closed     — no longer material OR remediation complete
//
// `notificationDeadlineAt` is a snapshot of the 10-BD clock taken at
// `discoveredAt`. The router recomputes it when `discoveredAt` changes
// unless the caller explicitly overrides it (mirrors `DataBreach`).
enum ControlWeaknessSeverity {
  low
  medium
  high
  critical
}

enum ControlWeaknessStatus {
  open
  triaging
  notified
  remediating
  closed
}

enum ControlWeaknessRemediabilityDecision {
  pending
  remediable_in_time
  not_remediable_in_time
}

model ControlWeakness {
  id        String  @id @default(cuid())
  tenantId  String
  /// Optional link to the control whose weakness this records. Nullable
  /// because a weakness may surface before the control is catalogued
  /// (e.g. from a pen-test finding or third-party attestation gap).
  controlId String?

  title       String
  description String?                 @db.Text
  severity    ControlWeaknessSeverity
  status      ControlWeaknessStatus   @default(open)

  // Timeline.
  discoveredAt           DateTime  @default(now())
  /// Snapshot of `discoveredAt + 10 business days` at create-time per
  /// CPS 234 Para 35. Stored explicitly so reviewers can override the
  /// computed value when the discovery point itself is uncertain.
  notificationDeadlineAt DateTime
  /// Date by which the entity expects to remediate. Used by the
  /// router/UI to surface "remediation will overrun the 10-BD clock".
  expectedRemediationAt  DateTime?
  remediatedAt           DateTime?

  /// Materiality + remediability decision (Para 35 trigger).
  /// `pending`              — entity still assessing.
  /// `remediable_in_time`   — material, but expected to be remediated
  ///                          within an entity-defined timely window
  ///                          (no notification required).
  /// `not_remediable_in_time` — APRA notification required within 10
  ///                          business days of becoming aware.
  remediability ControlWeaknessRemediabilityDecision @default(pending)

  rootCause       String? @db.Text
  remediationPlan String? @db.Text

  /// APRA notification (Para 35).
  apraNotificationRequired Boolean   @default(false)
  apraNotifiedAt           DateTime?
  apraReference            String?

  reportedById String?
  assigneeId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  control    Control? @relation(fields: [controlId], references: [id], onDelete: SetNull)
  reportedBy User?    @relation("ControlWeaknessReporter", fields: [reportedById], references: [id])
  assignee   User?    @relation("ControlWeaknessAssignee", fields: [assigneeId], references: [id])

  @@index([tenantId])
  @@index([status])
  @@index([severity])
  @@index([notificationDeadlineAt])
  @@index([discoveredAt])
}

// --- device.prisma ---
// Endpoint device posture models. Powers the cross-platform device agent
// (apps/device-agent): an agent installed on an employee computer enrolls
// once, then heartbeats its security posture (disk encryption, firewall,
// screen lock, antivirus, agent health). Each Device is 1:1 with a
// "computer"-category Asset. Reported posture is INVENTORY telemetry and is
// stored inline; the COMPLIANCE interpretation lands as advisory Evidence
// (pending_review), never an auto-verdict. See docs/device-agent.md.

enum DeviceEnrollmentTokenStatus {
  active
  consumed
  revoked
  expired
}

enum DevicePlatform {
  macos
  windows
  linux
}

enum DeviceStatus {
  pending // enrolled, no check-in yet
  active // checked in within the heartbeat window
  stale // missed the heartbeat window
  revoked // credential revoked; check-ins are rejected
  retired
}

// Tri-state per posture signal. `unknown` distinguishes "the agent could not
// determine this" from a definitive pass/fail.
enum PostureSignalState {
  pass
  fail
  unknown
}

// Admin-minted, short-lived, consumable bearer credential used to authorize
// non-interactive (MDM / mass-deploy) enrollment. Interactive installs use a
// signed-in user JWT instead and never need one of these.
model DeviceEnrollmentToken {
  id          String                      @id @default(cuid())
  tenantId    String
  // SHA-256 of the raw token. The raw value is returned exactly once at
  // creation and is never stored; enrollment looks it up by hash. This is a
  // one-way HASH (not the crypto-envelope) on purpose: an enrollment token is
  // only ever COMPARED, never used to recompute an HMAC — unlike
  // Device.secretEnc below, which must be reversible.
  tokenHash   String                      @unique
  label       String?
  status      DeviceEnrollmentTokenStatus @default(active)
  maxUses     Int                         @default(1)
  useCount    Int                         @default(0)
  expiresAt   DateTime
  createdById String?
  consumedAt  DateTime?
  revokedAt   DateTime?
  revokedById String?
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("DeviceTokenCreatedBy", fields: [createdById], references: [id])
  devices   Device[]

  @@index([tenantId])
  @@index([tenantId, status])
}

// Durable per-device identity, 1:1 with a "computer"-category Asset.
model Device {
  id           String         @id @default(cuid())
  tenantId     String
  assetId      String         @unique
  // Per-device HMAC secret, stored REVERSIBLY ENCRYPTED via the AES-256-GCM
  // crypto-envelope (enc:v1:) — NOT a one-way hash — because the server must
  // decrypt it to recompute and verify the HMAC of every check-in. Contrast
  // with DeviceEnrollmentToken.tokenHash, which is only ever compared.
  secretEnc    String
  // Bumped on every secret rotation; the agent echoes its keyId so a request
  // is verified against the right secret while a rotation propagates.
  secretKeyId  Int            @default(1)
  platform     DevicePlatform
  osVersion    String?
  agentVersion String?
  hostname     String?
  // Stable hardware fingerprint (serial / machine GUID) the agent reports;
  // used to detect re-enrollment of the same physical machine.
  hardwareId   String?

  status                 DeviceStatus @default(pending)
  enrolledById           String?
  // The Person this device is assigned to (Phase C). Resolved from the
  // enrolling user at enrollment; powers the per-person fleet posture rollup.
  personId               String?
  enrolledAt             DateTime     @default(now())
  lastSeenAt             DateTime?
  // Expected heartbeat cadence; drives stale detection.
  checkInIntervalSeconds Int          @default(3600)

  // Inline latest posture (inventory telemetry — the device's own
  // self-reported state). A compliance verdict is never stored here.
  diskEncryption PostureSignalState @default(unknown)
  firewall       PostureSignalState @default(unknown)
  screenLock     PostureSignalState @default(unknown)
  antivirus      PostureSignalState @default(unknown)
  agentHealthy   Boolean            @default(true)
  lastPostureAt  DateTime?
  // Full raw posture blob from the most recent check-in (extra signals,
  // versions, agent self-diagnostics) for the detail view.
  latestPosture  Json?

  enrollmentTokenId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant          Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset           Asset                   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  enrolledBy      User?                   @relation("DeviceEnrolledBy", fields: [enrolledById], references: [id])
  person          Person?                 @relation(fields: [personId], references: [id], onDelete: SetNull)
  enrollmentToken DeviceEnrollmentToken?  @relation(fields: [enrollmentTokenId], references: [id])
  snapshots       DevicePostureSnapshot[]
  nonces          DeviceNonce[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, lastSeenAt])
  @@index([tenantId, hardwareId])
  @@index([tenantId, personId])
}

// Append-only posture history (one row per check-in) for drift / audit trail.
model DevicePostureSnapshot {
  id             String             @id @default(cuid())
  tenantId       String
  deviceId       String
  diskEncryption PostureSignalState
  firewall       PostureSignalState
  screenLock     PostureSignalState
  antivirus      PostureSignalState
  agentHealthy   Boolean
  osVersion      String?
  agentVersion   String?
  raw            Json?
  collectedAt    DateTime // agent-reported collection time
  receivedAt     DateTime           @default(now()) // server receipt time

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([tenantId, deviceId, collectedAt])
}

// Per-device check-in nonce ledger for replay defense. Intentionally has NO
// tenantId: it is written/read by the device-auth middleware BEFORE a tenant
// context exists (the request is authenticated by the per-device secret, and
// the tenant is derived from the Device row afterwards), so it is accessed
// via the un-scoped base client. Rows are pruned by the stale-device sweep
// once older than the signature clock-skew window.
model DeviceNonce {
  id       String   @id @default(cuid())
  deviceId String
  nonce    String
  seenAt   DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, nonce])
  @@index([seenAt])
}

// Short-lived, single-use authorization code for the device agent's browser
// sign-in (PKCE / OAuth-device style). Minted by an authenticated web session
// at POST /auth/device/authorize and exchanged exactly once by the agent (with
// the PKCE verifier) at POST /auth/device/token for a device JWT. This is how a
// shipped agent signs in against any auth provider: the browser owns the login
// (password or SSO), then deep-links the code back to the waiting agent.
model DeviceAuthCode {
  id            String    @id @default(cuid())
  // Random opaque code handed to the browser and deep-linked to the agent.
  code          String    @unique
  userId        String
  tenantId      String
  // base64url(SHA-256(code_verifier)). The agent proves possession of the
  // verifier at exchange time, so an intercepted code is useless on its own.
  codeChallenge String
  // The trustalo:// (allow-listed scheme) target the browser deep-links to.
  redirectUri   String
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// --- evidence.prisma ---
enum EvidenceType {
  document
  screenshot
  link
  automated
  attestation
}

enum EvidenceApprovalStatus {
  draft
  pending_review
  approved
  rejected
  expired
  stale
}

enum RenewalFrequency {
  once
  monthly
  quarterly
  semi_annually
  annually
}

model Evidence {
  id          String                 @id @default(cuid())
  tenantId    String
  controlId   String
  title       String
  description String?
  type        EvidenceType           @default(document)
  status      EvidenceApprovalStatus @default(draft)

  fileKey  String?
  fileName String?
  fileSize Int?
  mimeType String?

  externalUrl String?

  sourceType String?
  sourceId   String?

  collectedAt DateTime  @default(now())
  validFrom   DateTime  @default(now())
  expiresAt   DateTime?

  renewalFrequency   RenewalFrequency?
  nextRenewalDate    DateTime?
  reminderDaysBefore Int               @default(30)
  lastReminderSentAt DateTime?

  // Nullable to support automated submitters such as the per-control
  // Evidence Agent, which has no associated user identity. Manual
  // submissions from the UI continue to populate this with the
  // signed-in user's id.
  submittedById String?
  reviewedById  String?
  reviewedAt    DateTime?
  reviewNotes   String?

  tags     String[]
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  control     Control @relation(fields: [controlId], references: [id], onDelete: Cascade)
  submittedBy User?   @relation("EvidenceSubmittedBy", fields: [submittedById], references: [id])
  reviewedBy  User?   @relation("EvidenceReviewedBy", fields: [reviewedById], references: [id])

  @@index([tenantId])
  @@index([controlId])
  @@index([expiresAt])
  @@index([status])
}

// --- framework.prisma ---
enum FrameworkType {
  iso27001
  iso27017
  iso27018
  iso22301
  iso42001
  soc2
  essential8
  nist_csf_2
  gdpr
  cps234
}

enum FrameworkInstanceStatus {
  not_started
  in_progress
  ready_for_audit
  certified
}

enum MappingRelationship {
  equivalent // 1:1 same control intent
  partial // overlapping but not identical
  informs // referenced as supporting guidance
}

model Framework {
  id            String        @id @default(cuid())
  name          String
  version       String
  description   String?
  frameworkType FrameworkType
  totalControls Int
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  instances    FrameworkInstance[]
  requirements Requirement[]
}

model FrameworkInstance {
  id                  String                  @id @default(cuid())
  tenantId            String
  frameworkId         String
  status              FrameworkInstanceStatus @default(not_started)
  isEnabled           Boolean                 @default(true)
  targetDate          DateTime?
  certifiedAt         DateTime?
  // Optional target maturity/tier for tiered frameworks
  // (e.g. Essential Eight: "ml1"/"ml2"/"ml3"; NIST CSF: "tier1"–"tier4").
  // Null for non-tiered frameworks.
  targetMaturityLevel String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  tenant                        Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  framework                     Framework                      @relation(fields: [frameworkId], references: [id])
  controlRequirementAssignments ControlRequirementAssignment[]
  audits                        Audit[]

  @@unique([tenantId, frameworkId])
  @@index([tenantId])
}

model Requirement {
  id               String  @id @default(cuid())
  frameworkId      String
  identifier       String
  title            String
  description      String?
  evidenceGuidance String?
  category         String?
  // Optional maturity/tier marker for tiered frameworks
  // (e.g. Essential Eight: "ml1"/"ml2"/"ml3"; NIST CSF tiers if used per-requirement).
  // Allows the UI to dim/highlight requirements based on the org's targetMaturityLevel.
  maturityLevel    String?
  sortOrder        Int

  framework                     Framework                      @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  controlRequirementAssignments ControlRequirementAssignment[]
  mappingsAsSource              FrameworkRequirementMapping[]  @relation("MappingSource")
  mappingsAsTarget              FrameworkRequirementMapping[]  @relation("MappingTarget")

  @@index([frameworkId])
}

// Catalog-level cross-framework requirement mapping (org-agnostic).
// Pre-seeded from authoritative sources (NIST CSF Informative References,
// ACSC Essential Eight mapping appendix, AICPA SOC 2 mappings, etc.) so
// evidence collected for one framework can satisfy mapped requirements
// in others. Distinct from ControlRequirementAssignment which is org-scoped.
model FrameworkRequirementMapping {
  id                  String              @id @default(cuid())
  sourceRequirementId String
  targetRequirementId String
  relationship        MappingRelationship @default(partial)
  rationale           String?
  source              String // e.g. "NIST CSF 2.0 Informative References v1.0"
  createdAt           DateTime            @default(now())

  sourceRequirement Requirement @relation("MappingSource", fields: [sourceRequirementId], references: [id], onDelete: Cascade)
  targetRequirement Requirement @relation("MappingTarget", fields: [targetRequirementId], references: [id], onDelete: Cascade)

  @@unique([sourceRequirementId, targetRequirementId, relationship])
  @@index([sourceRequirementId])
  @@index([targetRequirementId])
}

model ControlRequirementAssignment {
  id                  String  @id @default(cuid())
  tenantId            String
  requirementId       String
  controlId           String
  frameworkInstanceId String
  status              String?

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requirement       Requirement       @relation(fields: [requirementId], references: [id])
  control           Control           @relation(fields: [controlId], references: [id])
  frameworkInstance FrameworkInstance @relation(fields: [frameworkInstanceId], references: [id])

  @@unique([controlId, frameworkInstanceId, requirementId])
  @@index([tenantId])
}

// --- incident.prisma ---
enum IncidentSeverity {
  critical
  high
  medium
  low
  informational
}

enum IncidentStatus {
  reported
  investigating
  contained
  resolved
  closed
  lessons_learned
}

model Incident {
  id                             String           @id @default(cuid())
  tenantId                       String
  title                          String
  description                    String?
  severity                       IncidentSeverity
  status                         IncidentStatus   @default(reported)
  reportedById                   String
  assignedToId                   String?
  detectedAt                     DateTime?
  resolvedAt                     DateTime?
  rootCause                      String?
  regulatoryNotificationRequired Boolean          @default(false)
  regulatoryNotifiedAt           DateTime?
  createdAt                      DateTime         @default(now())
  updatedAt                      DateTime         @updatedAt

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reportedBy User               @relation("IncidentReporter", fields: [reportedById], references: [id])
  assignedTo User?              @relation("IncidentAssignee", fields: [assignedToId], references: [id])
  timeline   IncidentTimeline[]

  @@index([tenantId])
}

model IncidentTimeline {
  id            String   @id @default(cuid())
  incidentId    String
  tenantId      String
  action        String
  description   String?
  performedById String
  createdAt     DateTime @default(now())

  incident    Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  performedBy User     @relation(fields: [performedById], references: [id])

  @@index([tenantId])
  @@index([incidentId])
}

// --- people.prisma ---
// People — the HR / personnel directory. A `Person` is the canonical
// per-tenant record for anyone in scope for compliance (staff, contractors,
// vendor contacts). It REPLACES the old `Membership` model: it carries the
// org link, status, role-based access (role + permissions override — RBAC
// semantics unchanged), AND HR attributes. A Person optionally links to a
// `User` (login identity) — null for people who haven't been invited / never
// log in. Devices and assets are assigned to a Person; training/policy
// completions roll up via the linked User.
//
// The module, API (/api/v1/people), RBAC (people:*), nav and UI are all
// "People"; a single row is a `Person`. See docs/people + the People plan.

enum PersonStatus {
  invited
  active
  suspended
  offboarded
}

enum PersonKind {
  employee
  contractor
  vendor_contact
  service_account
  other
}

enum PersonSource {
  manual
  invite
  directory_sync
  self_register
}

// Same string values as the console roles (so the rbac.ts role->permission map
// is shared, keyed by string) plus `member`, the default. A fresh enum — NOT
// the legacy `MembershipRole` — so the migration needs no transaction-unsafe
// `ALTER TYPE ... ADD VALUE`, and the People role set can evolve as Membership
// is retired.
enum PersonRole {
  member
  owner
  admin
  compliance_manager
  auditor
  viewer
  integration_admin
  dpo
}

model Person {
  id       String  @id @default(cuid())
  tenantId String
  // Login identity. Null for people who haven't been invited / never log in.
  // Unique per tenant when set (Postgres treats NULLs as distinct, so many
  // login-less people are allowed).
  userId   String?

  email    String
  fullName String

  // Role-based RBAC, identical semantics to the old Membership: effective
  // permissions = `permissions` when non-empty, else getPermissionsForRole(role).
  role        PersonRole   @default(member)
  permissions String[]
  status      PersonStatus @default(invited)
  kind        PersonKind   @default(employee)
  source      PersonSource @default(manual)

  // HR attributes (populated over time; surfaced/edited in the People UI).
  jobTitle       String?
  department     String?
  employmentType String?
  managerId      String?
  location       String?
  startDate      DateTime?
  endDate        DateTime?

  // Vendor-as-person link (Phase D): a vendor contact promoted to a Person so
  // they can be vetted / acknowledge policies / take training like staff.
  vendorId String?

  invitedAt DateTime?
  joinedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  manager Person?  @relation("PersonManager", fields: [managerId], references: [id])
  reports Person[] @relation("PersonManager")
  vendor  Vendor?  @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  // HR / compliance sub-resources + asset associations (Phases B & C).
  backgroundChecks BackgroundCheck[]
  checklistItems   PersonChecklistItem[]
  devices          Device[]
  assignedAssets   Asset[]               @relation("AssetAssignedPerson")

  @@unique([tenantId, userId])
  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([userId])
  @@index([tenantId, vendorId])
}

// ── Phase B: background checks ──────────────────────────────────────────
// Pre-employment / periodic vetting record. Many per Person (history); the
// latest per type is the current state. A `cleared` check emits advisory
// Evidence (ISO 27001:2022 A.6.1 screening).

enum BackgroundCheckType {
  identity
  criminal
  employment
  education
  credit
  reference
  other
}

enum BackgroundCheckStatus {
  not_started
  in_progress
  cleared
  flagged
  expired
}

model BackgroundCheck {
  id              String                @id @default(cuid())
  tenantId        String
  personId        String
  type            BackgroundCheckType   @default(identity)
  status          BackgroundCheckStatus @default(not_started)
  provider        String?
  reference       String?
  adverseFindings Boolean               @default(false)
  notes           String?
  requestedAt     DateTime?
  completedAt     DateTime?
  expiresAt       DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([personId])
  @@index([tenantId, status])
  @@index([tenantId, expiresAt])
}

// ── Phase B: onboarding / offboarding checklists ────────────────────────
// Templated task items seeded on status transitions (invited→active seeds
// onboarding; →offboarded seeds offboarding). Completing the offboarding set
// emits advisory Evidence (A.6.5 termination/change of employment).

enum ChecklistKind {
  onboarding
  offboarding
}

enum ChecklistItemStatus {
  pending
  done
  na
}

model PersonChecklistItem {
  id          String              @id @default(cuid())
  tenantId    String
  personId    String
  kind        ChecklistKind
  key         String
  label       String
  status      ChecklistItemStatus @default(pending)
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, kind, key])
  @@index([tenantId])
  @@index([personId, kind])
}

// --- policy.prisma ---
enum PolicyStatus {
  draft
  pending_approval
  approved
  published
  archived
}

model Policy {
  id               String       @id @default(cuid())
  tenantId         String
  title            String
  description      String?
  status           PolicyStatus @default(draft)
  category         String?
  ownerId          String
  currentVersionId String?
  renewalDate      DateTime?
  // Phase 2 (AI accelerators): short Markdown summary surfaced on the
  // public Trust Center for published policies. Generated once via the
  // AI provider on first publish; admins can override manually.
  publicSummary    String?      @db.Text
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner           User                   @relation("PolicyOwner", fields: [ownerId], references: [id])
  versions        PolicyVersion[]
  acknowledgments PolicyAcknowledgment[]
  policyControls  PolicyControl[]
  comments        PolicyComment[]

  @@index([tenantId])
}

model PolicyVersion {
  id            String    @id @default(cuid())
  policyId      String
  versionNumber Int
  content       String    @db.Text
  changeNotes   String?
  createdById   String
  approvedById  String?
  approvedAt    DateTime?
  createdAt     DateTime  @default(now())

  policy          Policy                 @relation(fields: [policyId], references: [id], onDelete: Cascade)
  createdBy       User                   @relation("PolicyVersionCreator", fields: [createdById], references: [id])
  approvedBy      User?                  @relation("PolicyVersionApprover", fields: [approvedById], references: [id])
  acknowledgments PolicyAcknowledgment[]
  comments        PolicyComment[]

  @@index([policyId])
}

model PolicyAcknowledgment {
  id              String   @id @default(cuid())
  policyId        String
  policyVersionId String
  userId          String
  tenantId        String
  acknowledgedAt  DateTime @default(now())
  createdAt       DateTime @default(now())

  policy        Policy        @relation(fields: [policyId], references: [id], onDelete: Cascade)
  policyVersion PolicyVersion @relation(fields: [policyVersionId], references: [id])
  user          User          @relation(fields: [userId], references: [id])
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([policyId])
}

model PolicyComment {
  id              String    @id @default(cuid())
  policyId        String
  policyVersionId String?
  userId          String
  tenantId        String
  content         String    @db.Text
  highlightedText String?   @db.Text
  fromPos         Int?
  toPos           Int?
  resolved        Boolean   @default(false)
  resolvedById    String?
  resolvedAt      DateTime?
  parentId        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  policy        Policy          @relation(fields: [policyId], references: [id], onDelete: Cascade)
  policyVersion PolicyVersion?  @relation(fields: [policyVersionId], references: [id])
  user          User            @relation("PolicyCommentAuthor", fields: [userId], references: [id])
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  resolvedBy    User?           @relation("PolicyCommentResolver", fields: [resolvedById], references: [id])
  parent        PolicyComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       PolicyComment[] @relation("CommentReplies")

  @@index([policyId])
  @@index([policyVersionId])
  @@index([tenantId])
  @@index([parentId])
}

model PolicyControl {
  id        String   @id @default(cuid())
  policyId  String
  controlId String
  tenantId  String
  createdAt DateTime @default(now())

  policy  Policy  @relation(fields: [policyId], references: [id], onDelete: Cascade)
  control Control @relation(fields: [controlId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([policyId, controlId])
  @@index([tenantId])
  @@index([policyId])
  @@index([controlId])
}

/// System-wide policy library (not tenant-scoped). Seeded on install; extend FrameworkType in schema for new frameworks.
model PolicyTemplate {
  id               String          @id @default(cuid())
  slug             String          @unique
  title            String
  shortDescription String?
  /// Suggested category for the new policy record
  category         String?
  /// Empty array = applies to all current frameworks; otherwise filter by overlap
  frameworkTypes   FrameworkType[]
  /// Future-proof labels (e.g. "hipaa", "pci") without enum migration — informational / filter
  tags             String[]        @default([])
  contentHtml      String          @db.Text
  sortOrder        Int             @default(0)
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([isActive, sortOrder])
}

// --- privacy.prisma ---
// ============================================================
// GDPR / Privacy program models
//
// The privacy module is built around four registers, each parallel to a
// concrete GDPR obligation:
//
//   1. ProcessingActivity  — Article 30 Records of Processing Activities (RoPA)
//   2. DPIA                — Article 35 Data Protection Impact Assessments
//   3. DataBreach          — Articles 33/34 Personal-data breach notifications
//   4. DSARRequest         — Articles 12–22 Data-Subject Access Requests
//
// The shape mirrors the patterns established by AI Governance (similar
// `*Status` lifecycle enums, approver fields, indexes) so the API and UI
// layers can reuse the same conventions.
// ============================================================

// ── Lawful basis under Art. 6(1) ───────────────────────────────────────
enum LawfulBasis {
  consent
  contract
  legal_obligation
  vital_interests
  public_task
  legitimate_interests
}

// ── Categories of personal data on a processing activity ───────────────
// Distinct from "sensitive" — special_category and criminal trigger Art. 9/10.
enum DataCategory {
  identity
  contact
  financial
  health
  location
  online_identifier
  demographic
  employment
  usage
  special_category
  criminal
  other
}

// ── Categories of data subject ─────────────────────────────────────────
enum SubjectCategory {
  customer
  employee
  prospect
  supplier_contact
  minor
  website_visitor
  patient
  other
}

// ── Cross-border transfer safeguard (Chapter V) ────────────────────────
enum TransferMechanism {
  none_eu_eea
  adequacy_decision
  scc
  bcr
  derogation_art_49
}

// ── Role of the organisation in the processing activity ────────────────
enum ProcessingRole {
  controller
  processor
  joint_controller
}

enum ProcessingActivityStatus {
  draft
  active
  under_review
  retired
}

// ── DPIA lifecycle. Mirrors AIImpactStatus by intent so reviewers see a
//    familiar approve/reject pattern across modules. ───────────────────
enum DPIAStatus {
  draft
  in_review
  approved
  rejected
}

// ── Article 35(3) DPIA-necessity outcome ───────────────────────────────
enum DPIANecessity {
  required
  recommended
  not_required
}

// ── Personal-data breach taxonomy ──────────────────────────────────────
// Severity mirrors AIIncidentSeverity so the dashboard treatment is the same.
enum DataBreachSeverity {
  low
  medium
  high
  critical
}

// CIA-style taxonomy used in WP29 / EDPB guidance for breach categorisation.
enum DataBreachCategory {
  confidentiality
  integrity
  availability
  combined
}

enum DataBreachStatus {
  open
  investigating
  contained
  notified
  closed
}

// ── DSAR taxonomy ──────────────────────────────────────────────────────
enum DSARType {
  access
  rectification
  erasure
  restriction
  portability
  objection
  automated_decision
  withdraw_consent
}

enum DSARStatus {
  received
  identity_pending
  in_progress
  extended
  fulfilled
  refused
  closed
}

enum DSARChannel {
  email
  web_form
  post
  phone
  in_person
}

// ─────────────────────────────────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────────────────────────────────

// Article 30 — Records of Processing Activities (RoPA)
//
// Each row describes one distinct purpose of personal-data processing carried
// out by the organisation. This is THE defining GDPR artifact: every other
// privacy resource (DPIA, breach scope, DSAR scope, sub-processor link) is
// expressed in terms of one or more processing activities.
model ProcessingActivity {
  id       String @id @default(cuid())
  tenantId String

  // Human-readable name (e.g. "Customer billing", "Employee performance reviews").
  name    String
  // Specified, explicit, legitimate purpose under Art. 5(1)(b).
  purpose String
  // Whether the organisation acts as controller, processor or joint controller
  // for THIS processing activity (an org can be controller in one and processor
  // in another).
  role    ProcessingRole @default(controller)

  // Lawful basis under Art. 6(1) and the textual justification supporting it
  // (e.g. for legitimate_interests the LIA outcome).
  lawfulBasis              LawfulBasis
  lawfulBasisJustification String?

  // Inventory of what's processed and about whom.
  dataCategories    DataCategory[]
  subjectCategories SubjectCategory[]
  // Free-form additional data-element list ("first name, email, IP, etc.").
  dataElements      String[]
  // Recipients to whom data is disclosed (categories or named entities).
  recipients        String[]

  // Cross-border transfers (Chapter V).
  crossBorderTransfer  Boolean            @default(false)
  transferMechanism    TransferMechanism?
  transferDestinations String[]

  // Retention & security narrative.
  retentionPeriod  String?
  securityMeasures String?

  // Ownership.
  ownerId String?
  status  ProcessingActivityStatus @default(draft)

  // Review cadence — used by the dashboard "due for review" KPI.
  lastReviewedAt DateTime?
  nextReviewAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner  User?  @relation("ProcessingActivityOwner", fields: [ownerId], references: [id])

  dpias    DPIA[]
  breaches DataBreach[]
  dsars    DSARRequest[] @relation("DSARProcessingActivities")
  vendors  Vendor[]      @relation("VendorProcessingActivities")
  risks    Risk[]

  @@index([tenantId])
  @@index([status])
  @@index([nextReviewAt])
}

// Article 35 — Data Protection Impact Assessment
//
// A DPIA is rooted to a single ProcessingActivity (the activity that triggered
// the DPIA obligation). Multiple DPIAs are allowed per activity to support
// re-assessment cycles.
model DPIA {
  id       String @id @default(cuid())
  tenantId String

  processingActivityId String
  assessedById         String

  title     String
  // Article 35(3) DPIA-necessity outcome. `required` means the DPIA was
  // mandatory; `recommended` means the org chose to do one for prudence.
  necessity DPIANecessity @default(required)

  // Narrative fields modelled on the EDPB DPIA template.
  necessityProportionality String?
  riskToRights             String?
  mitigations              String?
  consultedDpo             Boolean @default(false)
  consultedDataSubjects    Boolean @default(false)

  // Residual risk after mitigations — what triggers Art. 36 prior consultation.
  residualRisk RiskRating?

  status       DPIAStatus @default(draft)
  approvedById String?
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  processingActivity ProcessingActivity @relation(fields: [processingActivityId], references: [id], onDelete: Cascade)
  assessedBy         User               @relation("DPIAAssessor", fields: [assessedById], references: [id])
  approvedBy         User?              @relation("DPIAApprover", fields: [approvedById], references: [id])

  @@index([tenantId])
  @@index([processingActivityId])
  @@index([status])
}

// Articles 33/34 — Personal-data breach register
//
// `notificationDeadlineAt` is auto-computed as `discoveredAt + 72h` by the
// API on create; the UI surfaces a countdown badge to the deadline. This
// mirrors the AIIncident pattern with breach-specific fields layered on top.
model DataBreach {
  id       String @id @default(cuid())
  tenantId String

  // Optional link to the processing activity in scope. Null when the breach
  // affects systems not yet captured in the RoPA.
  processingActivityId String?

  title       String
  description String?
  category    DataBreachCategory
  severity    DataBreachSeverity
  status      DataBreachStatus   @default(open)

  // Timeline.
  occurredAt             DateTime?
  discoveredAt           DateTime  @default(now())
  // Auto = discoveredAt + 72h. Stored explicitly so reviewers can override
  // when discovery itself was uncertain (e.g. forensic investigation reveals
  // an earlier discovery point).
  notificationDeadlineAt DateTime
  containedAt            DateTime?
  resolvedAt             DateTime?

  // Scope.
  affectedRecordsEstimate   Int?
  affectedSubjectCategories SubjectCategory[]
  dataCategoriesInvolved    DataCategory[]

  // Investigation.
  rootCause   String?
  containment String?
  remediation String?

  // Notification (Art. 33 + Art. 34).
  supervisoryAuthorityNotificationRequired Boolean   @default(false)
  supervisoryAuthorityNotifiedAt           DateTime?
  supervisoryAuthorityReference            String?
  dataSubjectsNotificationRequired         Boolean   @default(false)
  dataSubjectsNotifiedAt                   DateTime?

  reportedById String?
  assigneeId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  processingActivity ProcessingActivity? @relation(fields: [processingActivityId], references: [id])
  reportedBy         User?               @relation("DataBreachReporter", fields: [reportedById], references: [id])
  assignee           User?               @relation("DataBreachAssignee", fields: [assigneeId], references: [id])

  @@index([tenantId])
  @@index([status])
  @@index([severity])
  @@index([notificationDeadlineAt])
  @@index([discoveredAt])
}

// Articles 12–22 — Data-Subject Access Requests (DSAR / DSR)
//
// `dueAt` is auto-computed as `receivedAt + 1 month`. `extendedDueAt` extends
// by up to two further months under Art. 12(3). Both are surfaced as SLA
// badges in the UI.
model DSARRequest {
  id       String @id @default(cuid())
  tenantId String

  // Identifies the data subject. We collect the minimum necessary; identity
  // verification is captured separately (`identityVerifiedAt`).
  subjectName       String
  subjectEmail      String?
  subjectIdentifier String?

  requestType DSARType
  channel     DSARChannel
  status      DSARStatus  @default(received)

  // Timeline & SLA.
  receivedAt         DateTime  @default(now())
  dueAt              DateTime
  extendedAt         DateTime?
  extendedDueAt      DateTime?
  identityVerifiedAt DateTime?
  fulfilledAt        DateTime?
  closedAt           DateTime?

  // Outcome.
  refusalReason   String?
  responseNotes   String?
  // Optional storage key for any response artefact (export ZIP, etc.).
  responseFileKey String?

  // Free-form notes and an optional assignment.
  assigneeId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignee             User?                @relation("DSARAssignee", fields: [assigneeId], references: [id])
  processingActivities ProcessingActivity[] @relation("DSARProcessingActivities")

  @@index([tenantId])
  @@index([status])
  @@index([requestType])
  @@index([dueAt])
}

// --- questionnaires.prisma ---
// ============================================================
// Questionnaires — Phase 6 (AI accelerators).
//
// Customers regularly receive long security questionnaires (CAIQ,
// SIG, Whistic, custom CSVs). The questionnaire workspace lets a
// reviewer:
//
//   1. Import a questionnaire from CSV / CAIQ / SIG (we model this as
//      a file-format hint plus the raw row data).
//   2. Bulk-generate AI answers grounded in the org's existing policies,
//      controls and TenantContext (the "facts wallet").
//   3. Review, edit, approve and export the answered file in the
//      original format so it can be returned to the requester.
//
// Each Answer carries provenance — generatedByAi flag, model used,
// confidence, sources — so audit teams can prove which answers a human
// reviewed vs accepted as-is.
// ============================================================

enum QuestionnaireSourceFormat {
  csv
  caiq
  sig
  xlsx
  docx
  custom
}

enum QuestionnaireStatus {
  draft
  in_progress
  completed
  exported
}

enum QuestionType {
  yes_no
  short_text
  long_text
  multiple_choice
}

enum AnswerStatus {
  pending
  draft
  approved
  rejected
}

/// Lifecycle of an asynchronous questionnaire import job.
///
///   pending   — row created, file uploaded to S3, runner not started yet
///   running   — runner is parsing and/or calling the structure agent
///   completed — all sheets understood; Questionnaire row + Questions persisted
///   partial   — one or more sheets failed (agent timeout, schema rejection)
///               but at least one question_table sheet succeeded; the user can
///               accept the partial import or retry from the UI
///   failed    — terminal failure (no usable sheets, AI unavailable, etc.)
enum QuestionnaireImportJobStatus {
  pending
  running
  completed
  partial
  failed
}

/// Async import job — owns the long-running work that POST /questionnaires
/// used to do synchronously.
///
/// Why it exists:
///   • Structure-agent calls on a 5-sheet workbook take 30–180 s. Holding an
///     HTTP request open that long causes proxy timeouts (ALB 60 s default),
///     duplicate submissions on browser retry, and a horrible "stare at a
///     spinner" UX with no visibility into what's happening.
///   • Per-sheet progress is what users actually want to see — a list of
///     sheet names with ticks / spinners / failure markers is dramatically
///     better than a three-minute opaque spinner.
///
/// Lifecycle:
///   1. POST /questionnaires uploads the file to S3, creates this row with
///      status=pending, kicks off the runner, and returns 202 + jobId.
///   2. Runner sets status=running, parses sheets, and for each sheet calls
///      the LLM mapper in parallel (`Promise.allSettled`). Each settle
///      updates `progress.sheets[i]` so the UI poll can render per-sheet
///      ticks/spinners.
///   3. On success: creates the Questionnaire + Question rows, sets
///      `questionnaireId` on this job, status=completed (or =partial if some
///      sheets failed but at least one succeeded).
///   4. On terminal failure: status=failed, errorMessage carries the public-
///      safe copy.
///
/// We keep finished jobs in the table for audit/debug. A periodic janitor can
/// purge rows older than N days; not in scope for the first cut.
model QuestionnaireImportJob {
  id               String                       @id @default(cuid())
  tenantId         String
  /// Final questionnaire name (carried so the UI can show the title even
  /// while the job is still running).
  name             String
  requester        String?
  vendorId         String?
  dueDate          DateTime?
  /// User-supplied format hint (csv | xlsx | docx | …). Optional; the runner
  /// re-detects from file extension.
  formatHint       QuestionnaireSourceFormat?
  /// Detected source format once the runner has looked at the file.
  sourceFormat     QuestionnaireSourceFormat?
  /// S3 key of the uploaded original. Always set for xlsx/docx; null for
  /// CSV-string imports (the CSV body is captured in `csvBody` instead).
  originalFileKey  String?
  originalFilename String?
  originalMimeType String?
  /// Verbatim CSV body for paste-CSV imports. We persist it on the job so
  /// the runner can re-parse without round-tripping through S3.
  csvBody          String?                      @db.Text
  status           QuestionnaireImportJobStatus @default(pending)
  /// Free-shape progress descriptor consumed by the polling UI:
  ///   {
  ///     phase: "uploading" | "parsing" | "mapping" | "persisting",
  ///     totalSheets: number,
  ///     completedSheets: number,
  ///     sheets: [
  ///       { name: string, status: "pending"|"running"|"completed"|"failed",
  ///         kind?: "instructions"|"metadata"|"question_table"|"matrix",
  ///         questionCount?: number, error?: string }
  ///     ]
  ///   }
  /// Updated incrementally by the runner. The UI re-renders on every poll.
  progress         Json                         @default("{}")
  /// Public-safe error message for status=failed/partial. NEVER contains
  /// upstream secrets — the central error scrubber + AIProviderError public
  /// messages enforce that.
  errorMessage     String?                      @db.Text
  errorCode        String?
  /// Set when status transitions to completed/partial — points at the new
  /// Questionnaire row so the UI can navigate to it.
  questionnaireId  String?
  createdById      String
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  startedAt        DateTime?
  completedAt      DateTime?

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy     User           @relation("QuestionnaireImportJobCreator", fields: [createdById], references: [id])
  questionnaire Questionnaire? @relation(fields: [questionnaireId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

model Questionnaire {
  id               String                    @id @default(cuid())
  tenantId         String
  name             String
  sourceFormat     QuestionnaireSourceFormat @default(csv)
  /// Free-form name of the requesting party (a customer, prospect, regulator).
  requester        String?
  vendorId         String?
  dueDate          DateTime?
  status           QuestionnaireStatus       @default(draft)
  /// Headers from the *primary* sheet (the first sheet successfully
  /// parsed), kept for backwards-compat display + CSV export. Multi-
  /// sheet workbooks attach per-sheet headers to each `Question`.
  headers          Json                      @default("[]")
  /// Storage key + metadata for the uploaded original file. We keep
  /// the raw .xlsx / .docx blob in object storage so we can write
  /// answers back into the customer's original workbook (preserving
  /// styles, merged cells, branding, multi-sheet structure) instead
  /// of reconstructing a fresh file.
  originalFileKey  String?
  originalFilename String?
  originalMimeType String?
  /// LLM-produced structural map of the uploaded workbook/document.
  /// Describes each sheet/page (kind: metadata | instructions |
  /// question_table | matrix), its column roles, header row, sub-
  /// question relationships, and — critically — the exact A1 cell
  /// coordinates where each answer must be written on export. Stored
  /// verbatim so re-export is deterministic and we never re-run the
  /// agent. Null for CSV imports (structure is implicit).
  structureMap     Json?
  /// Cover-page / metadata facts extracted by the structure agent —
  /// e.g. {"Company Name": "Acme", "Service Provided": "..."}. Used
  /// (a) as additional grounding for the answering agent and (b)
  /// re-emitted to their original cells on export. Null for CSV.
  metadataFacts    Json?
  importedById     String
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  tenant     Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  importedBy User                     @relation("QuestionnaireImporter", fields: [importedById], references: [id])
  vendor     Vendor?                  @relation(fields: [vendorId], references: [id])
  questions  Question[]
  answers    Answer[]
  importJobs QuestionnaireImportJob[]

  @@index([tenantId])
  @@index([tenantId, status])
}

model Question {
  id                   String       @id @default(cuid())
  tenantId             String
  questionnaireId      String
  /// 1-based position in the source file. Used to preserve ordering on export.
  sequenceNumber       Int
  sectionTitle         String?
  questionText         String       @db.Text
  questionType         QuestionType @default(short_text)
  /// JSON array of choice strings for multiple_choice / yes_no.
  choices              Json         @default("[]")
  /// Verbatim row from the source file as parsed object — used to
  /// rehydrate columns we don't model explicitly (control IDs, weights).
  originalRow          Json         @default("{}")
  /// 0-based row index inside this question's source sheet (xlsx),
  /// table (docx), or line in the file (csv). Used by the exporter
  /// to drop the answer into the right cell.
  sourceRowIndex       Int?
  /// For xlsx round-trip: which sheet inside the workbook this row
  /// belongs to. A workbook can have many sheets, each with its own
  /// header row and answer column, so this is recorded per-question.
  sourceSheetName      String?
  /// For xlsx (and docx tables): 0-based index of the header row
  /// inside this question's source sheet/table. Different sheets in
  /// the same workbook can have headers at different rows.
  sourceHeaderRowIndex Int?
  /// Header text of the column that takes the answer on export, for
  /// THIS question's source sheet/table. Stored per-question because
  /// different sheets/tables in the same workbook may use different
  /// answer column names ("Response", "Answer", "Yes/No"). Null when
  /// no answer column was detected — the writer appends one.
  answerColumnHeader   String?
  /// For docx round-trip: 0-based index of the <w:tbl> inside
  /// `word/document.xml` this row belongs to. A document can hold
  /// many question tables; each question knows its own. Null for
  /// xlsx/csv.
  sourceTableIndex     Int?
  /// Exact A1-style cell reference (e.g. "F12") inside the source
  /// sheet/table where this question's answer must be written on
  /// export. Produced by the structure agent at import time — the
  /// writer just sets this cell, no header lookup needed. Supersedes
  /// the legacy (sourceRowIndex + answerColumnHeader) lookup; old
  /// fields are retained for backward compatibility with imports
  /// that pre-date the structure agent.
  answerCellA1         String?
  /// Self-reference to the parent question for nested sub-questions
  /// like "a) Has this policy been communicated?" under a top-level
  /// control question. The UI nests sub-questions under their parent;
  /// the answering agent gets the parent text as additional context.
  parentQuestionId     String?
  /// Structured contextual labels that frame this question — domain,
  /// sub-domain, control id, evidence requirement, matrix column
  /// label (the entity / system / process this cell asks about), etc.
  /// The UI renders these as chips above the question; the answering
  /// agent uses them as context.
  /// Shape is intentionally open: { domain?: string; subDomain?:
  /// string; controlId?: string; evidence?: string; column?: string;
  /// [k: string]: string | undefined }.
  contextLabels        Json?
  createdAt            DateTime     @default(now())

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  questionnaire Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  answers       Answer[]
  parent        Question?     @relation("QuestionChildren", fields: [parentQuestionId], references: [id], onDelete: SetNull)
  children      Question[]    @relation("QuestionChildren")

  @@index([tenantId])
  @@index([questionnaireId])
  @@index([questionnaireId, sequenceNumber])
  @@index([parentQuestionId])
}

model Answer {
  id              String       @id @default(cuid())
  tenantId        String
  questionnaireId String
  questionId      String       @unique
  content         String       @db.Text
  status          AnswerStatus @default(pending)
  generatedByAi   Boolean      @default(false)
  /// Bounded [0,1]; absent for human-authored answers.
  aiConfidence    Float?
  /// Free-form citations: which policy IDs / control IDs / context rows
  /// the AI cited as evidence. Helps reviewers verify quickly.
  aiSources       Json         @default("[]")
  aiModel         String?
  aiPrompt        String?      @db.Text
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  questionnaire Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  question      Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  reviewedBy    User?         @relation("AnswerReviewer", fields: [reviewedById], references: [id])

  @@index([tenantId])
  @@index([questionnaireId])
  @@index([questionnaireId, status])
}

