{
  "name": "@trustalo/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun dist/index.js",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:security": "bun test src/lib/crypto-envelope.test.ts src/lib/service-auth.test.ts src/config/security.test.ts",
    "test:security:coverage": "bun test --coverage src/lib/crypto-envelope.test.ts src/lib/service-auth.test.ts src/config/security.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "db:generate": "bun run prisma:combine && prisma generate",
    "db:migrate": "bun run prisma:combine && prisma migrate dev",
    "db:push": "bun run prisma:combine && prisma db push",
    "db:reset": "bun run prisma:combine && prisma migrate reset --force",
    "db:seed": "bun prisma/seed.ts",
    "db:seed:demo": "bun prisma/seed-demo.ts",
    "prisma:combine": "bun run scripts/combine-schemas.ts",
    "verify:tenant": "bun run scripts/check-tenant-allowlist.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@prisma/client-runtime-utils": "^7.5.0",
    "@trustalo/ai": "workspace:*",
    "@trustalo/auth": "workspace:*",
    "@trustalo/auth-provider-cognito": "workspace:*",
    "@trustalo/auth-provider-keycloak": "workspace:*",
    "@trustalo/auth-provider-local": "workspace:*",
    "@trustalo/integration-manifests": "workspace:*",
    "@trustalo/queue": "workspace:*",
    "@trustalo/shared": "workspace:*",
    "@trustalo/storage": "workspace:*",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.0.0",
    "isomorphic-dompurify": "^3.13.0",
    "jsonwebtoken": "^9.0.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "mongoose": "^9.3.0",
    "multer": "^2.1.1",
    "openai": "^6.33.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.13.0",
    "prisma": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.0",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/multer": "^2.1.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.0.0",
    "typescript": "^5.8.0"
  }
}
