enum AssetType {
  hardware
  software
  data
  service
  personnel
  facility
  cloud_resource
}

enum AssetClassification {
  public
  internal
  confidential
  restricted
}

enum AssetStatus {
  active
  decommissioned
  under_review
}

model Asset {
  id             String              @id @default(cuid())
  tenantId String
  name           String
  description    String?
  type           AssetType
  classification AssetClassification @default(internal)
  ownerId        String?
  deletedById    String?
  deletedAt      DateTime?
  location       String?
  status         AssetStatus         @default(active)
  metadata       Json?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner        User?        @relation("AssetOwner", fields: [ownerId], references: [id])
  deletedBy    User?        @relation("AssetDeletedBy", fields: [deletedById], references: [id])

  @@index([tenantId])
  @@index([tenantId, deletedAt, createdAt])
  @@index([tenantId, status, deletedAt])
}
