enum ControlStatus {
  not_implemented
  partially_implemented
  implemented
  not_applicable
}

model Control {
  id                    String        @id @default(cuid())
  tenantId              String
  title                 String
  description           String?
  implementationDetails String?       @db.Text
  status                ControlStatus @default(not_implemented)
  category              String?
  ownerId               String?
  reviewDate            DateTime?
  lastReviewedAt        DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  tenant                        Tenant                           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner                         User?                            @relation("ControlOwner", fields: [ownerId], references: [id])
  controlRequirementAssignments ControlRequirementAssignment[]
  auditFindings                 AuditFinding[]
  tasks                         Task[]
  evidence                      Evidence[]
  policyControls                PolicyControl[]
  evidenceCollectionConfig      ControlEvidenceCollectionConfig?
  weaknesses                    ControlWeakness[]

  @@index([tenantId])
}

// ── Evidence collection mode (per-control, per-tenant) ────────
//
// Lets a user choose whether evidence for a control is gathered
// manually (existing behaviour) or by the Evidence Agent. In agent
// mode, `agentInstructions` is the natural-language directive the
// LLM receives, and `agentToolConnectionIds` are the collector
// IntegrationConnection IDs the agent is allowed to call as tools.
enum EvidenceCollectionMode {
  manual
  agent
}

enum EvidenceAgentLastStatus {
  idle
  queued
  running
  succeeded
  failed
}

model ControlEvidenceCollectionConfig {
  id                     String                  @id @default(cuid())
  tenantId               String
  controlId              String                  @unique
  mode                   EvidenceCollectionMode  @default(manual)
  agentInstructions      String?                 @db.Text
  agentToolConnectionIds String[]                @default([])
  agentScheduleMinutes   Int?
  agentLastRunAt         DateTime?
  agentLastStatus        EvidenceAgentLastStatus @default(idle)
  agentLastRunId         String?
  agentLastSummary       String?                 @db.Text
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  control Control @relation(fields: [controlId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, mode])
}

// ── ControlWeakness ─────────────────────────────────────────────────
//
// Tracks information-security control weaknesses for the APRA CPS 234
// Para 35 10-business-day notification clock. The model is generic
// enough to also support other regulator weakness-notification clocks
// later (e.g. CPS 230 operational risk) — the CPS 234 specifics live
// in the helper `computeCps234ControlWeaknessDeadline` and the router.
//
// Lifecycle (mirrors `DataBreachStatus`):
//   open       — discovered, not yet triaged
//   triaging   — materiality + remediability under assessment
//   notified   — APRA has been notified (or a nil-return recorded)
//   remediating — material; remediation in flight
//   closed     — no longer material OR remediation complete
//
// `notificationDeadlineAt` is a snapshot of the 10-BD clock taken at
// `discoveredAt`. The router recomputes it when `discoveredAt` changes
// unless the caller explicitly overrides it (mirrors `DataBreach`).
enum ControlWeaknessSeverity {
  low
  medium
  high
  critical
}

enum ControlWeaknessStatus {
  open
  triaging
  notified
  remediating
  closed
}

enum ControlWeaknessRemediabilityDecision {
  pending
  remediable_in_time
  not_remediable_in_time
}

model ControlWeakness {
  id             String                  @id @default(cuid())
  tenantId       String
  /// Optional link to the control whose weakness this records. Nullable
  /// because a weakness may surface before the control is catalogued
  /// (e.g. from a pen-test finding or third-party attestation gap).
  controlId      String?

  title          String
  description    String?                 @db.Text
  severity       ControlWeaknessSeverity
  status         ControlWeaknessStatus   @default(open)

  // Timeline.
  discoveredAt   DateTime                @default(now())
  /// Snapshot of `discoveredAt + 10 business days` at create-time per
  /// CPS 234 Para 35. Stored explicitly so reviewers can override the
  /// computed value when the discovery point itself is uncertain.
  notificationDeadlineAt DateTime
  /// Date by which the entity expects to remediate. Used by the
  /// router/UI to surface "remediation will overrun the 10-BD clock".
  expectedRemediationAt  DateTime?
  remediatedAt           DateTime?

  /// Materiality + remediability decision (Para 35 trigger).
  /// `pending`              — entity still assessing.
  /// `remediable_in_time`   — material, but expected to be remediated
  ///                          within an entity-defined timely window
  ///                          (no notification required).
  /// `not_remediable_in_time` — APRA notification required within 10
  ///                          business days of becoming aware.
  remediability  ControlWeaknessRemediabilityDecision @default(pending)

  rootCause      String?                 @db.Text
  remediationPlan String?                @db.Text

  /// APRA notification (Para 35).
  apraNotificationRequired Boolean       @default(false)
  apraNotifiedAt           DateTime?
  apraReference            String?

  reportedById   String?
  assigneeId     String?

  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  control  Control? @relation(fields: [controlId], references: [id], onDelete: SetNull)
  reportedBy User?  @relation("ControlWeaknessReporter", fields: [reportedById], references: [id])
  assignee   User?  @relation("ControlWeaknessAssignee", fields: [assigneeId], references: [id])

  @@index([tenantId])
  @@index([status])
  @@index([severity])
  @@index([notificationDeadlineAt])
  @@index([discoveredAt])
}
