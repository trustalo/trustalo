enum EvidenceType {
  document
  screenshot
  link
  automated
  attestation
}

enum EvidenceApprovalStatus {
  draft
  pending_review
  approved
  rejected
  expired
  stale
}

enum RenewalFrequency {
  once
  monthly
  quarterly
  semi_annually
  annually
}

model Evidence {
  id             String                 @id @default(cuid())
  tenantId String
  controlId      String
  title          String
  description    String?
  type           EvidenceType           @default(document)
  status         EvidenceApprovalStatus @default(draft)

  fileKey   String?
  fileName  String?
  fileSize  Int?
  mimeType  String?

  externalUrl String?

  sourceType String?
  sourceId   String?

  collectedAt DateTime @default(now())
  validFrom   DateTime @default(now())
  expiresAt   DateTime?

  renewalFrequency   RenewalFrequency?
  nextRenewalDate    DateTime?
  reminderDaysBefore Int               @default(30)
  lastReminderSentAt DateTime?

  // Nullable to support automated submitters such as the per-control
  // Evidence Agent, which has no associated user identity. Manual
  // submissions from the UI continue to populate this with the
  // signed-in user's id.
  submittedById String?
  reviewedById  String?
  reviewedAt    DateTime?
  reviewNotes   String?

  tags     String[]
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  control      Control      @relation(fields: [controlId], references: [id], onDelete: Cascade)
  submittedBy  User?        @relation("EvidenceSubmittedBy", fields: [submittedById], references: [id])
  reviewedBy   User?        @relation("EvidenceReviewedBy", fields: [reviewedById], references: [id])

  @@index([tenantId])
  @@index([controlId])
  @@index([expiresAt])
  @@index([status])
}
