enum FrameworkType {
  iso27001
  iso27017
  iso27018
  iso22301
  iso42001
  soc2
  essential8
  nist_csf_2
  gdpr
  cps234
  hipaa
  pci_dss_4
}

enum FrameworkInstanceStatus {
  not_started
  in_progress
  ready_for_audit
  certified
}

enum MappingRelationship {
  equivalent // 1:1 same control intent
  partial    // overlapping but not identical
  informs    // referenced as supporting guidance
}

model Framework {
  id            String        @id @default(cuid())
  name          String
  version       String
  description   String?
  frameworkType  FrameworkType
  totalControls Int
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  instances    FrameworkInstance[]
  requirements Requirement[]
}

model FrameworkInstance {
  id                   String                  @id @default(cuid())
  tenantId       String
  frameworkId          String
  status               FrameworkInstanceStatus @default(not_started)
  isEnabled            Boolean                 @default(true)
  targetDate           DateTime?
  certifiedAt          DateTime?
  // Optional target maturity/tier for tiered frameworks
  // (e.g. Essential Eight: "ml1"/"ml2"/"ml3"; NIST CSF: "tier1"–"tier4").
  // Null for non-tiered frameworks.
  targetMaturityLevel  String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  framework       Framework        @relation(fields: [frameworkId], references: [id])
  controlRequirementAssignments ControlRequirementAssignment[]
  audits          Audit[]

  @@unique([tenantId, frameworkId])
  @@index([tenantId])
}

model Requirement {
  id               String  @id @default(cuid())
  frameworkId      String
  identifier       String
  title            String
  description      String?
  evidenceGuidance String?
  category         String?
  // Optional maturity/tier marker for tiered frameworks
  // (e.g. Essential Eight: "ml1"/"ml2"/"ml3"; NIST CSF tiers if used per-requirement).
  // Allows the UI to dim/highlight requirements based on the org's targetMaturityLevel.
  maturityLevel    String?
  sortOrder        Int

  framework         Framework                     @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  controlRequirementAssignments ControlRequirementAssignment[]
  mappingsAsSource  FrameworkRequirementMapping[] @relation("MappingSource")
  mappingsAsTarget  FrameworkRequirementMapping[] @relation("MappingTarget")

  @@index([frameworkId])
}

// Catalog-level cross-framework requirement mapping (org-agnostic).
// Pre-seeded from authoritative sources (NIST CSF Informative References,
// ACSC Essential Eight mapping appendix, AICPA SOC 2 mappings, etc.) so
// evidence collected for one framework can satisfy mapped requirements
// in others. Distinct from ControlRequirementAssignment which is org-scoped.
model FrameworkRequirementMapping {
  id                  String              @id @default(cuid())
  sourceRequirementId String
  targetRequirementId String
  relationship        MappingRelationship @default(partial)
  rationale           String?
  source              String // e.g. "NIST CSF 2.0 Informative References v1.0"
  createdAt           DateTime            @default(now())

  sourceRequirement Requirement @relation("MappingSource", fields: [sourceRequirementId], references: [id], onDelete: Cascade)
  targetRequirement Requirement @relation("MappingTarget", fields: [targetRequirementId], references: [id], onDelete: Cascade)

  @@unique([sourceRequirementId, targetRequirementId, relationship])
  @@index([sourceRequirementId])
  @@index([targetRequirementId])
}

model ControlRequirementAssignment {
  id                  String @id @default(cuid())
  tenantId      String
  requirementId       String
  controlId           String
  frameworkInstanceId  String
  status              String?

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requirement       Requirement       @relation(fields: [requirementId], references: [id])
  control           Control           @relation(fields: [controlId], references: [id])
  frameworkInstance  FrameworkInstance  @relation(fields: [frameworkInstanceId], references: [id])

  @@unique([controlId, frameworkInstanceId, requirementId])
  @@index([tenantId])
}
