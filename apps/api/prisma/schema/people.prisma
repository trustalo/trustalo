// People — the HR / personnel directory. A `Person` is the canonical
// per-tenant record for anyone in scope for compliance (staff, contractors,
// vendor contacts). It REPLACES the old `Membership` model: it carries the
// org link, status, role-based access (role + permissions override — RBAC
// semantics unchanged), AND HR attributes. A Person optionally links to a
// `User` (login identity) — null for people who haven't been invited / never
// log in. Devices and assets are assigned to a Person; training/policy
// completions roll up via the linked User.
//
// The module, API (/api/v1/people), RBAC (people:*), nav and UI are all
// "People"; a single row is a `Person`. See docs/people + the People plan.

enum PersonStatus {
  invited
  active
  suspended
  offboarded
}

enum PersonKind {
  employee
  contractor
  vendor_contact
  service_account
  other
}

enum PersonSource {
  manual
  invite
  directory_sync
  self_register
}

// Same string values as the console roles (so the rbac.ts role->permission map
// is shared, keyed by string) plus `member`, the default. A fresh enum — NOT
// the legacy `MembershipRole` — so the migration needs no transaction-unsafe
// `ALTER TYPE ... ADD VALUE`, and the People role set can evolve as Membership
// is retired.
enum PersonRole {
  member
  owner
  admin
  compliance_manager
  auditor
  viewer
  integration_admin
  dpo
}

model Person {
  id       String  @id @default(cuid())
  tenantId String
  // Login identity. Null for people who haven't been invited / never log in.
  // Unique per tenant when set (Postgres treats NULLs as distinct, so many
  // login-less people are allowed).
  userId   String?

  email    String
  fullName String

  // Role-based RBAC, identical semantics to the old Membership: effective
  // permissions = `permissions` when non-empty, else getPermissionsForRole(role).
  role        PersonRole     @default(member)
  permissions String[]
  status      PersonStatus   @default(invited)
  kind        PersonKind     @default(employee)
  source      PersonSource   @default(manual)

  // HR attributes (populated over time; surfaced/edited in the People UI).
  jobTitle       String?
  department     String?
  employmentType String?
  managerId      String?
  location       String?
  startDate      DateTime?
  endDate        DateTime?

  // Vendor-as-person link (Phase D): a vendor contact promoted to a Person so
  // they can be vetted / acknowledge policies / take training like staff.
  vendorId String?

  invitedAt DateTime?
  joinedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  manager Person?  @relation("PersonManager", fields: [managerId], references: [id])
  reports Person[] @relation("PersonManager")
  vendor  Vendor?  @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  // HR / compliance sub-resources + asset associations (Phases B & C).
  backgroundChecks BackgroundCheck[]
  checklistItems   PersonChecklistItem[]
  devices          Device[]
  assignedAssets   Asset[]               @relation("AssetAssignedPerson")

  @@unique([tenantId, userId])
  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([userId])
  @@index([tenantId, vendorId])
}

// ── Phase B: background checks ──────────────────────────────────────────
// Pre-employment / periodic vetting record. Many per Person (history); the
// latest per type is the current state. A `cleared` check emits advisory
// Evidence (ISO 27001:2022 A.6.1 screening).

enum BackgroundCheckType {
  identity
  criminal
  employment
  education
  credit
  reference
  other
}

enum BackgroundCheckStatus {
  not_started
  in_progress
  cleared
  flagged
  expired
}

model BackgroundCheck {
  id              String                @id @default(cuid())
  tenantId        String
  personId        String
  type            BackgroundCheckType   @default(identity)
  status          BackgroundCheckStatus @default(not_started)
  provider        String?
  reference       String?
  adverseFindings Boolean               @default(false)
  notes           String?
  requestedAt     DateTime?
  completedAt     DateTime?
  expiresAt       DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([personId])
  @@index([tenantId, status])
  @@index([tenantId, expiresAt])
}

// ── Phase B: onboarding / offboarding checklists ────────────────────────
// Templated task items seeded on status transitions (invited→active seeds
// onboarding; →offboarded seeds offboarding). Completing the offboarding set
// emits advisory Evidence (A.6.5 termination/change of employment).

enum ChecklistKind {
  onboarding
  offboarding
}

enum ChecklistItemStatus {
  pending
  done
  na
}

model PersonChecklistItem {
  id          String              @id @default(cuid())
  tenantId    String
  personId    String
  kind        ChecklistKind
  key         String
  label       String
  status      ChecklistItemStatus @default(pending)
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, kind, key])
  @@index([tenantId])
  @@index([personId, kind])
}
