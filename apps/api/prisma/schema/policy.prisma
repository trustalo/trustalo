enum PolicyStatus {
  draft
  pending_approval
  approved
  published
  archived
}

model Policy {
  id               String       @id @default(cuid())
  tenantId   String
  title            String
  description      String?
  status           PolicyStatus @default(draft)
  category         String?
  ownerId          String
  currentVersionId String?
  renewalDate      DateTime?
  // Phase 2 (AI accelerators): short Markdown summary surfaced on the
  // public Trust Center for published policies. Generated once via the
  // AI provider on first publish; admins can override manually.
  publicSummary    String?      @db.Text
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner            User                  @relation("PolicyOwner", fields: [ownerId], references: [id])
  versions         PolicyVersion[]
  acknowledgments  PolicyAcknowledgment[]
  policyControls   PolicyControl[]
  comments         PolicyComment[]

  @@index([tenantId])
}

model PolicyVersion {
  id            String    @id @default(cuid())
  policyId      String
  versionNumber Int
  content       String    @db.Text
  changeNotes   String?
  createdById   String
  approvedById  String?
  approvedAt    DateTime?
  createdAt     DateTime  @default(now())

  policy          Policy                @relation(fields: [policyId], references: [id], onDelete: Cascade)
  createdBy       User                  @relation("PolicyVersionCreator", fields: [createdById], references: [id])
  approvedBy      User?                 @relation("PolicyVersionApprover", fields: [approvedById], references: [id])
  acknowledgments PolicyAcknowledgment[]
  comments        PolicyComment[]

  @@index([policyId])
}

model PolicyAcknowledgment {
  id              String   @id @default(cuid())
  policyId        String
  policyVersionId String
  userId          String
  tenantId  String
  acknowledgedAt  DateTime @default(now())
  createdAt       DateTime @default(now())

  policy        Policy        @relation(fields: [policyId], references: [id], onDelete: Cascade)
  policyVersion PolicyVersion @relation(fields: [policyVersionId], references: [id])
  user          User          @relation(fields: [userId], references: [id])
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([policyId])
}

model PolicyComment {
  id               String   @id @default(cuid())
  policyId         String
  policyVersionId  String?
  userId           String
  tenantId   String
  content          String   @db.Text
  highlightedText  String?  @db.Text
  fromPos          Int?
  toPos            Int?
  resolved         Boolean  @default(false)
  resolvedById     String?
  resolvedAt       DateTime?
  parentId         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  policy        Policy         @relation(fields: [policyId], references: [id], onDelete: Cascade)
  policyVersion PolicyVersion? @relation(fields: [policyVersionId], references: [id])
  user          User           @relation("PolicyCommentAuthor", fields: [userId], references: [id])
  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  resolvedBy    User?          @relation("PolicyCommentResolver", fields: [resolvedById], references: [id])
  parent        PolicyComment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       PolicyComment[] @relation("CommentReplies")

  @@index([policyId])
  @@index([policyVersionId])
  @@index([tenantId])
  @@index([parentId])
}

model PolicyControl {
  id             String   @id @default(cuid())
  policyId       String
  controlId      String
  tenantId String
  createdAt      DateTime @default(now())

  policy       Policy       @relation(fields: [policyId], references: [id], onDelete: Cascade)
  control      Control      @relation(fields: [controlId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([policyId, controlId])
  @@index([tenantId])
  @@index([policyId])
  @@index([controlId])
}

/// System-wide policy library (not tenant-scoped). Seeded on install; extend FrameworkType in schema for new frameworks.
model PolicyTemplate {
  id               String          @id @default(cuid())
  slug             String          @unique
  title            String
  shortDescription String?
  /// Suggested category for the new policy record
  category         String?
  /// Empty array = applies to all current frameworks; otherwise filter by overlap
  frameworkTypes   FrameworkType[]
  /// Future-proof labels (e.g. "hipaa", "pci") without enum migration — informational / filter
  tags             String[]        @default([])
  contentHtml      String          @db.Text
  sortOrder        Int             @default(0)
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([isActive, sortOrder])
}
