enum TaskType {
  manual
  automated
  recurring
}

enum TaskStatus {
  pending
  in_progress
  completed
  overdue
  cancelled
}

enum TaskPriority {
  critical
  high
  medium
  low
}

enum TaskFrequency {
  once
  daily
  weekly
  monthly
  quarterly
  annually
}

enum TaskSourceModule {
  training
  control
  risk
  evidence
  vendor
  asset
  audit
  policy
  bcp
  incident
  // Privacy / GDPR program task sources.
  dsar
  data_breach
  dpia
  processing_activity
}

enum EvidenceStatus {
  draft
  pending_review
  approved
  rejected
}

model Task {
  id             String            @id @default(cuid())
  tenantId String
  title          String
  description    String?
  type           TaskType          @default(manual)
  status         TaskStatus        @default(pending)
  priority       TaskPriority      @default(medium)
  assigneeId     String?
  controlId      String?
  sourceModule   TaskSourceModule?
  sourceId       String?
  dueDate        DateTime?
  completedAt    DateTime?
  frequency      TaskFrequency?
  nextDueDate    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  tenant Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignee     User?          @relation("TaskAssignee", fields: [assigneeId], references: [id])
  control      Control?       @relation(fields: [controlId], references: [id])
  evidence     TaskEvidence[]

  @@index([tenantId])
  @@index([assigneeId])
  @@index([sourceModule, sourceId])
  @@index([status])
  @@index([dueDate])
}

model TaskEvidence {
  id             String         @id @default(cuid())
  taskId         String
  tenantId String
  title          String
  description    String?
  fileUrl        String?
  sourceType     String
  sourceId       String?
  status         EvidenceStatus @default(draft)
  submittedById  String
  approvedById   String?
  approvedAt     DateTime?
  expiresAt      DateTime?
  createdAt      DateTime       @default(now())

  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  submittedBy  User         @relation("EvidenceSubmitter", fields: [submittedById], references: [id])
  approvedBy   User?        @relation("EvidenceApprover", fields: [approvedById], references: [id])

  @@index([tenantId])
  @@index([taskId])
}
