// A `Tenant` represents a paying customer organisation. Was previously
// called `Organization`; the rename moved every domain table's foreign
// key column from `organizationId` to `tenantId` so the multi-tenant
// concept is consistent across the whole stack. The product UI may
// still surface the word "Organisation" — that is purely a label.

enum TenantPlan {
  free
  starter
  professional
  enterprise
}

enum TenantStatus {
  active
  suspended
  cancelled
}

// Controls how aggressive the collector should be when binding an
// integration to tenant Controls on connect.
//
//   auto    — Persist IntegrationCheckControl rows immediately with
//             isEnabled=true. Evidence flows as soon as the next
//             collection job runs.
//   suggest — Persist rows with isEnabled=false +
//             disabledReason=pending_confirmation so the UI can show a
//             preview ("Connecting GitHub will contribute to 12
//             controls"). User confirms via
//             POST /connections/:id/bindings/confirm to flip them on.
//   off     — Don't bind at all; the user wires controls manually.
//
// Default is `suggest` to keep auditor scrutiny in the loop while
// still showing the unified preview UX.
enum IntegrationAutoBindMode {
  auto
  suggest
  off
}

model Tenant {
  id                      String                  @id @default(cuid())
  name                    String
  slug                    String                  @unique
  plan                    TenantPlan              @default(free)
  status                  TenantStatus            @default(active)
  integrationAutoBindMode IntegrationAutoBindMode @default(suggest)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  settings                      TenantSettings?
  memberships                   Membership[]
  people                        Person[]
  frameworkInstances            FrameworkInstance[]
  controls                      Control[]
  policies                      Policy[]
  policyAcks                    PolicyAcknowledgment[]
  risks                         Risk[]
  riskAssessments               RiskAssessment[]
  riskTreatments                RiskTreatment[]
  riskRegisterConfig            RiskRegisterConfig?
  riskMatrixChanges             RiskMatrixChange[]
  vendors                       Vendor[]
  vendorAssessments             VendorAssessment[]
  vendorResearches              VendorResearch[]
  vendorDocuments               VendorDocument[]
  assets                        Asset[]
  incidents                     Incident[]
  incidentTimelines             IncidentTimeline[]
  audits                        Audit[]
  auditDocuments                AuditDocument[]
  auditFindings                 AuditFinding[]
  bcps                          BusinessContinuityPlan[]
  bias                          BusinessImpactAnalysis[]
  bcpExercises                  BCPExercise[]
  aiSystems                     AISystem[]
  aiRiskAssessments             AIRiskAssessment[]
  aiImpactAssessments           AIImpactAssessment[]
  aiIncidents                   AIIncident[]
  tasks                         Task[]
  taskEvidence                  TaskEvidence[]
  trainingPrograms              TrainingProgram[]
  trainingCompletions           TrainingCompletion[]
  trainingQuizzes               TrainingQuiz[]
  quizAttempts                  QuizAttempt[]
  aiProviderConfigs             AIProviderConfig[]
  aiFeatureConfigs              AIFeatureConfig[]
  trustCenterConfig             TrustCenterConfig?
  trustResources                TrustResource[]
  accessRequests                TrustCenterAccessRequest[]
  trustCenterSnapshots          TrustCenterSnapshot[]
  trustCenterEvents             TrustCenterEvent[]
  controlRequirementAssignments ControlRequirementAssignment[]
  evidence                      Evidence[]
  policyControls                PolicyControl[]
  policyComments                PolicyComment[]
  vulnerabilities               Vulnerability[]
  processingActivities          ProcessingActivity[]
  dpias                         DPIA[]
  dataBreaches                  DataBreach[]
  dsarRequests                  DSARRequest[]
  contextEntries                TenantContext[]
  contextProposals              TenantContextProposal[]
  conversations                 Conversation[]
  conversationMessages          Message[]
  questionnaires                Questionnaire[]
  questions                     Question[]
  answers                       Answer[]
  questionnaireImportJobs       QuestionnaireImportJob[]
  controlWeaknesses             ControlWeakness[]
  directorySyncConfigs          DirectorySyncConfig[]
  directorySyncRuns             DirectorySyncRun[]
  externalIdentityMappings      ExternalIdentityMapping[]
  devices                       Device[]
  deviceEnrollmentTokens        DeviceEnrollmentToken[]
  devicePostureSnapshots        DevicePostureSnapshot[]
  // EE: managed LiteLLM routing + metered billing. See
  // prisma/schema/billing.ee.prisma.
  billingConfig                 TenantBillingConfig?
  litellmKey                    TenantLiteLLMKey?
  creditWallet                  CreditWallet?
}

model TenantSettings {
  id          String   @id @default(cuid())
  tenantId    String   @unique
  companySize String?
  industry    String?
  country     String?
  timezone    String?
  logoUrl     String?
  defaults    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}
