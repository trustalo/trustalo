# Collector Service (apps/collector)
# Copy to .env for local development

NODE_ENV=development
LOG_LEVEL=debug
COLLECTOR_PORT=4001
COLLECTOR_URL=http://localhost:4001
CORS_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL (integration domain)
COLLECTOR_DATABASE_URL=postgresql://trustalo:trustalo@localhost:5433/trustalo_collector

# JWT Authentication (must match API's JWT_SECRET)
JWT_SECRET=change-me-in-production

# Internal API client (collector -> API for evidence submission)
API_BASE_URL=http://localhost:4000
API_INTERNAL_KEY=change-me-in-production

# Credential encryption (AES-256-GCM, exactly 64 hex characters)
CREDENTIAL_ENCRYPTION_KEY=change-me-64-hex-chars-representing-32-bytes-aes256-key-here000

# AWS SQS
QUEUE_PROVIDER=sqs
SQS_ENDPOINT=http://localhost:4566
SQS_EVIDENCE_QUEUE_URL=http://localhost:4566/000000000000/trustalo-evidence
SQS_JOBS_QUEUE_URL=http://localhost:4566/000000000000/trustalo-jobs
