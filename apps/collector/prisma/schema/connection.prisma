enum ConnectionStatus {
  connected
  disconnected
  error
  syncing
  pending_auth
}

// A tenant's binding to a specific Integration. Credentials live in
// `SecretVault` and are referenced via `secretId`; this row only carries
// metadata + non-secret config.
model IntegrationConnection {
  id                   String           @id @default(cuid())
  tenantId             String
  integrationId        String
  name                 String
  status               ConnectionStatus @default(pending_auth)
  // Reference to a `SecretVault` row that holds the AES-GCM ciphertext
  // for the connection's credentials. Null only while a connection is
  // in `pending_auth` and no secret has been issued yet.
  secretId             String?
  config               Json?
  lastSyncAt           DateTime?
  lastErrorMessage     String?
  syncFrequencyMinutes Int              @default(1440)
  isActive             Boolean          @default(true)
  // Snapshot of the manifest version the connection was last
  // reconciled against. The reconciler compares this with the loaded
  // manifest's `version` to detect manifest version bumps that require
  // re-binding (e.g. a new check was added to GitHub).
  manifestVersion      String?
  // Stamp the reconciler updates on every successful tick. Drives the
  // nightly safety-net query ("find connections not reconciled in 24h").
  lastReconciledAt     DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  integration Integration              @relation(fields: [integrationId], references: [id])
  jobs        CollectionJob[]
  syncLogs    SyncLog[]
  checks      IntegrationCheck[]
  checkControls IntegrationCheckControl[]
  checkResults IntegrationCheckResult[]

  @@unique([tenantId, integrationId, name])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([secretId])
  @@index([lastReconciledAt])
}
