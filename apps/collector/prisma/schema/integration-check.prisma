// Integration checks live in the collector because the runtime that
// evaluates them (manifest, HTTP probe, Playwright runner) is owned by
// the collector. The API queries this over HTTP when it needs to show
// check status next to a control.
//
// `controlId` is a loose string reference to `Control` in the API DB —
// no Prisma relation, since the two services have independent
// datasources. Integrity is enforced at the application layer when
// checks are linked to controls via the connector manifest.

enum IntegrationCheckStatus {
  pass
  fail
  error
  skipped
  pending
}

enum IntegrationCheckSeverity {
  low
  medium
  high
  critical
}

// Operational health of an automated check. Independent of the
// assertion outcome (`IntegrationCheckStatus`): a check can be
// `IntegrationCheckStatus.fail` (customer environment is non-compliant)
// while still being `CheckHealthState.healthy` (we got a clean result).
// `degraded`/`failing`/`overdue` mean we *lost visibility* — that's
// what surfaces as `automationHealth` on the API-side control view.
enum CheckHealthState {
  healthy
  degraded
  overdue
  failing
  paused
}

model IntegrationCheck {
  id            String                   @id @default(cuid())
  tenantId      String
  // The `IntegrationConnection` row this check belongs to. A connection
  // is always linked to exactly one `Integration` (catalog row), so we
  // do not duplicate `integrationId` here — join through `connection`
  // when needed.
  connectionId  String
  integrationId String
  // Stable manifest identifier, e.g. "aws.iam.root_mfa_enabled".
  // For prompt-derived custom checks this is "custom.<cuid>".
  manifestKey   String
  title         String
  description   String?                  @db.Text
  severity      IntegrationCheckSeverity @default(medium)
  // Cron-style schedule honoured by the worker. Defaults to daily.
  schedule      String                   @default("0 6 * * *")
  isEnabled     Boolean                  @default(true)
  // Which runtime evaluates this check:
  //  * "manifest" — connector-bundled check, executed via the connector's
  //    own logic (see @trustalo/integration-manifests).
  //  * "http"     — universal HTTP/TLS probe (runs inline in collector).
  //  * "browser"  — Playwright-driven assertion.
  runner        String                   @default("manifest")
  spec          Json?
  aiPrompt      String?                  @db.Text
  aiModel       String?
  lastStatus    IntegrationCheckStatus   @default(pending)
  lastRunAt     DateTime?
  lastEvidenceId String?

  // ── Health / overdue tracking ─────────────────────────────────────
  // Wall-clock instant we expect the next successful run by. Filled
  // when a check is scheduled, used by the overdue detector cron.
  expectedNextRunAt   DateTime?
  // Most recent successful run; drives the "last successful collection"
  // metric on dashboards.
  lastSuccessfulRunAt DateTime?
  // Counter the runner increments per consecutive non-retriable failure
  // and resets on the next success. 0/1/2 = degraded, 3+ = failing.
  consecutiveFailures Int               @default(0)
  // Operational health (see `CheckHealthState`). Updated by the runner
  // after each result and by the overdue-detector cron.
  healthState         CheckHealthState  @default(healthy)
  healthChangedAt     DateTime?
  // Short human-readable explanation surfaced in the UI ("3 consecutive
  // 401s — credentials likely rotated").
  healthReason        String?

  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  connection  IntegrationConnection     @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  integration Integration               @relation(fields: [integrationId], references: [id])
  controls    IntegrationCheckControl[]
  results     IntegrationCheckResult[]
  coverageGaps EvidenceCoverageGap[]

  @@unique([connectionId, manifestKey])
  @@index([tenantId])
  @@index([lastStatus])
  @@index([healthState])
  @@index([expectedNextRunAt])
}

// Many-to-many: one check can satisfy multiple controls. `controlId`
// is an opaque string id from the API service (no FK). Reconciliation
// state is tracked here, not by deleting rows, so auditors can see
// "this binding existed from X to Y" via `disabledAt` + `disabledReason`.
enum IntegrationCheckControlDisabledReason {
  // Binding awaiting user confirmation (tenant policy = "suggest").
  pending_confirmation
  // User explicitly disabled the binding from the UI.
  user_disabled
  // Tenant set the Control status to `not_applicable`.
  control_not_applicable
  // Control no longer exists (hard-deleted from the API).
  control_deleted
  // FrameworkInstance the control was assigned through was disabled.
  framework_disabled
  // FrameworkRef no longer resolves to this control (e.g. the
  // ControlRequirementAssignment was changed under PUT /controls/:id/mappings).
  ref_unmapped
  // The owning manifest check/capability was removed in a manifest
  // version bump.
  manifest_removed
}

model IntegrationCheckControl {
  id                 String   @id @default(cuid())
  tenantId           String
  integrationCheckId String
  connectionId       String
  controlId          String
  // Reconciler-managed lifecycle. Disabled rows are kept for audit
  // history; the runner only attaches Evidence to enabled bindings.
  isEnabled          Boolean                                @default(true)
  disabledReason     IntegrationCheckControlDisabledReason?
  disabledAt         DateTime?
  lastReconciledAt   DateTime                               @default(now())
  createdAt          DateTime                               @default(now())

  integrationCheck IntegrationCheck      @relation(fields: [integrationCheckId], references: [id], onDelete: Cascade)
  connection       IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([integrationCheckId, controlId])
  @@index([tenantId])
  @@index([controlId])
  @@index([tenantId, isEnabled])
}

model IntegrationCheckResult {
  id                 String                 @id @default(cuid())
  tenantId           String
  integrationCheckId String
  connectionId       String
  status             IntegrationCheckStatus
  payload            Json?
  errorMessage       String?                @db.Text
  durationMs         Int?
  // Opaque id from the API service when this run produced an Evidence
  // record. Pure string ref — no FK.
  evidenceId         String?
  createdAt          DateTime               @default(now())

  integrationCheck IntegrationCheck      @relation(fields: [integrationCheckId], references: [id], onDelete: Cascade)
  connection       IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([integrationCheckId, createdAt])
  @@index([status])
}

// Why an EvidenceCoverageGap was opened. The runner classifies the
// thrown error via `classifyError()`; the overdue detector uses
// `schedule_missed`; the binder uses `manifest_removed`. Audit-side
// queries filter by reason to distinguish "we can't reach the
// customer's environment" from "we're throttled" from "we paused
// ourselves".
enum CoverageGapReason {
  connection_error
  credentials_invalid
  rate_limited
  check_runtime_error
  schedule_missed
  manifest_removed
  paused_by_user
}

// A continuous window in which automated evidence collection failed
// or was skipped for an `IntegrationCheck`. Opens when an operational
// failure occurs after retry-exhaust (or immediately for
// non-retriable errors), closes on the next successful run. Survives
// binding churn — `affectedControlIds` is a snapshot of the
// IntegrationCheckControl set at gap-open time so auditors can ask
// "which controls lost coverage during this window?" without joining
// against current bindings.
model EvidenceCoverageGap {
  id                 String              @id @default(cuid())
  tenantId           String
  integrationCheckId String
  // Snapshot at gap-open time. Re-querying live bindings would lose
  // history if the tenant disabled a framework while the gap was
  // open.
  affectedControlIds String[]
  reason             CoverageGapReason
  startedAt          DateTime            @default(now())
  endedAt            DateTime?
  // Last error the runner / detector observed before the gap closed.
  // Surfaced verbatim in the recommended-action UI string.
  lastErrorMessage   String?
  // Per-run counter. Distinct from `IntegrationCheck.consecutiveFailures`
  // because a gap may straddle multiple retry cycles.
  retryCount         Int                 @default(0)
  // Set by the gap-escalator when an API-side ControlWeakness is auto-
  // created. Used to prevent duplicate weaknesses on the next tick.
  controlWeaknessId  String?
  // Set by the hourly gap-escalator. Used to debounce escalations
  // (we don't want to notify hourly forever) and to track how many
  // notification rounds a gap has triggered for SRE dashboards.
  lastEscalatedAt    DateTime?
  escalationCount    Int                 @default(0)

  integrationCheck IntegrationCheck @relation(fields: [integrationCheckId], references: [id], onDelete: Cascade)

  @@index([tenantId, endedAt])
  @@index([integrationCheckId, startedAt])
  @@index([tenantId, reason, endedAt])
}
